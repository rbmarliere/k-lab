VNG_PORT := 40404

INCLUDE ../include/defaults.conf

DEFAULTS OVERRIDE
DEPS = libcap tcpdump libnuma python3-yaml python3-jsonschema iperf iproute2 net-tools net-tools-deprecated ipv6toolkit netsniff-ng smcroute dropwatch
VNG_ARGS = --user root
DIE_ON_FAILURE = 0
BUILD_TYPE = defconfig

TEST := patchcheck

TEST_START IF ${TEST} == patchcheck
TEST_TYPE = patchcheck
CHECKOUT = ipv6_mod
PATCHCHECK_TYPE = build
PATCHCHECK_START = HEAD~10
ADD_CONFIG = ${BUILD_DIR}/tools/testing/selftests/net/config ${CONFIG_DIR}/ipv6=n.config

TEST_START IF ${TEST} == patchcheck
TEST_TYPE = patchcheck
CHECKOUT = ipv6_mod
PATCHCHECK_TYPE = build
PATCHCHECK_START = HEAD~10
ADD_CONFIG = ${BUILD_DIR}/tools/testing/selftests/net/config ${CONFIG_DIR}/ipv6=y.config

TEST_START IF ${TEST} == patchcheck
TEST_TYPE = patchcheck
CHECKOUT = ipv6_mod
PATCHCHECK_TYPE = build
PATCHCHECK_START = HEAD~10
ADD_CONFIG = ${BUILD_DIR}/tools/testing/selftests/net/forwarding/config ${CONFIG_DIR}/ipv6=n.config

TEST_START IF ${TEST} == patchcheck
TEST_TYPE = patchcheck
CHECKOUT = ipv6_mod
PATCHCHECK_TYPE = build
PATCHCHECK_START = HEAD~10
ADD_CONFIG = ${BUILD_DIR}/tools/testing/selftests/net/forwarding/config ${CONFIG_DIR}/ipv6=y.config

TEST_START IF ${TEST} == selftests
TEST_TYPE = test
CHECKOUT = ipv6_mod
ADD_CONFIG = ${BUILD_DIR}/tools/testing/selftests/net/config
TEST = ${DO_TEST_SIMPLE}
TEST_DIR = ${OUTPUT_DIR}/kselftest/kselftest_install
POST_BUILD_APPEND = ${RUN} ${THIS_DIR}/hooks/selftests/net/post-build
PREP_TEST = mount -t tmpfs tmp /tmp && cd ${TEST_DIR} && mkdir logs-n &&
TEST_BIN = ./run_kselftest.sh -c net -p; cp /tmp/* logs-n

TEST_START IF ${TEST} == selftests
TEST_TYPE = test
CHECKOUT = ipv6_mod
ADD_CONFIG = ${BUILD_DIR}/tools/testing/selftests/net/forwarding/config
TEST = ${DO_TEST_SIMPLE}
TEST_DIR = ${OUTPUT_DIR}/kselftest/kselftest_install
POST_BUILD_APPEND = ${RUN} ${THIS_DIR}/hooks/selftests/net/post-build
PREP_TEST = mount -t tmpfs tmp /tmp && cd ${TEST_DIR} && mkdir logs-f &&
TEST_BIN = ./run_kselftest.sh -c net/forwarding -p; cp /tmp/* logs-f
