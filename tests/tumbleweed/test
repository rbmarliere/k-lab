INCLUDE ../../include/defaults.conf

DEFAULTS IF NOT DEFINED TEST
TEST := build

DEFAULTS OVERRIDE
ROOT_DISK = /roots/suse/Tumbleweed/x86_64.img
CHROOT = /roots/suse/Tumbleweed/x86_64

TEST_START IF ${TEST} == build
TEST_TYPE = build

TEST_START IF ${TEST} == boot
TEST_TYPE = test
TEST = ${SSH} sh -c 'uname -m | grep -qx ${KLAB_UNAME_ARCH} && test -b /dev/vda'

TEST_START IF ${TEST} == chroot
TEST_TYPE = build
CHROOT_BUILD = 1

TEST_START IF ${TEST} == chroot-boot
TEST_TYPE = test
CHROOT_BUILD = 1
TEST = ${SSH} sh -c 'uname -m | grep -qx ${KLAB_UNAME_ARCH} && test -b /dev/vda'

TEST_START IF ${TEST} == bpf
TEST_TYPE = test
TEST_DIR = /mnt/build/kselftest/kselftest_install/bpf
TEST_BIN = ./test_progs -vv -t btf
TEST = ${SSH} sh -c 'mount bpffs /sys/fs/bpf -t bpf && cd ${TEST_DIR} && ${TEST_BIN}'
POST_BUILD_APPEND = ${RUN} ${THIS_DIR}/hooks/selftests/post-build bpf
ADD_CONFIG = ${BUILD_DIR}/tools/testing/selftests/bpf/config ${BUILD_DIR}/tools/testing/selftests/bpf/config.${KLAB_ARCH}
