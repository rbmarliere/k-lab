ARCH := x86_64
INCLUDE ${THIS_DIR}/include/defaults.conf
INCLUDE ${THIS_DIR}/profiles/Tumbleweed-x86_64.conf

DEFAULTS IF NOT DEFINED TEST
TEST := build

DEFAULTS IF ${TEST} == bpf
INCLUDE ${THIS_DIR}/include/selftests.conf

DEFAULTS IF ${TEST} == ltp
INCLUDE ${THIS_DIR}/include/ltp.conf

TEST_START IF ${TEST} == build
TEST_TYPE = build

TEST_START IF ${TEST} == boot
TEST_TYPE = test
TEST = ${SSH} test -b /dev/vda

TEST_START IF ${TEST} == manual
TEST_TYPE = test
RUN_TIMEOUT =
TEST = ${SSH} sleep infinity

TEST_START IF ${TEST} == chroot
TEST_TYPE = build
CHROOT_KERNEL = /roots/Tumbleweed/x86_64

TEST_START IF ${TEST} == chroot-boot
TEST_TYPE = test
CHROOT_KERNEL = /roots/Tumbleweed/x86_64
TEST = ${SSH} test -b /dev/vda

TEST_START IF ${TEST} == ltp
TEST_TYPE = test
CHROOT_USER = /roots/Tumbleweed/x86_64
LTP_TARGETS = testcases/kernel/syscalls/getpid
POST_BUILD_APPEND = ${BUILD_LTP}
TEST = ${SSH} env LTPROOT=/mnt/build/ltp /mnt/build/ltp/testcases/bin/getpid01

TEST_START IF ${TEST} == bpf
TEST_TYPE = test
TEST_DIR = /mnt/build/kselftest/kselftest_install/bpf
TEST = ${SSH} sh -c 'mount bpffs /sys/fs/bpf -t bpf && cd ${TEST_DIR} && ./test_progs'
SELFTEST_TARGETS = bpf
POST_BUILD_APPEND = ${BUILD_SELFTESTS}
ADD_CONFIG = ${ADD_CONFIG} ${BUILD_DIR}/tools/testing/selftests/bpf/config ${BUILD_DIR}/tools/testing/selftests/bpf/config.${KLAB_ARCH}
