ROOT_DISK := /roots/suse/15.7/x86_64.img
ARCH := x86_64
VNG_PORT := 23000

INCLUDE /linux/k-lab/include/defaults.conf

DEFAULTS IF NOT DEFINED TEST
TEST := default

VNG_ARGS = --user root
BUILD_TYPE = defconfig

TEST_START IF ${TEST} == default
TEST_TYPE = test
TEST_BIN = uname -m | grep -qx x86_64 && test -b /dev/vda
TEST = ${DO_TEST_SIMPLE}
