INCLUDE ../../include/defaults.conf

DEFAULTS OVERRIDE

TEST_DIR = ${OUTPUT_DIR}/kselftest/kselftest_install/net
PREP_TEST = cd ${TEST_DIR} &&

VNG_ARGS = --user root

POST_BUILD_APPEND = ${RUN} ${THIS_DIR}/hooks/selftests/net/post-build

# Needs: libcap tcpdump libnuma python3-yaml python3-jsonschema iperf
# iproute2 net-tools net-tools-deprecated ipv6toolkit netsniff-ng smcroute
# dropwatch

ADD_CONFIG = ${BUILD_DIR}/tools/testing/selftests/net/config


TEST_START IF ${TEST} == all
TEST_TYPE = test
TEST_BIN = cd .. && ./run_kselftest.sh -c net
TEST = ${DO_TEST_SIMPLE}


TEST_START IF ${TEST} == stress_reuseport_listen_sh
TEST_TYPE = test
TEST_BIN = ./stress_reuseport_listen.sh
PATTERN = exec of "./stress_reuseport_listen" failed: No such file or directory
TEST = ${DO_TEST_PATTERN_FAIL}


TEST_START IF ${TEST} == rtnetlink_sh
TEST_TYPE = test
TEST_BIN = ./rtnetlink.sh
TEST = ${DO_TEST_SIMPLE}
