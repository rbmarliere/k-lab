INCLUDE ../../include/defaults.conf

DEFAULTS OVERRIDE

TEST_DIR = ${OUTPUT_DIR}/kselftest/kselftest_install/namespaces
PREP_TEST = cd ${TEST_DIR} &&

VNG_ARGS = --user root

POST_BUILD_APPEND = ${RUN} ${THIS_DIR}/hooks/selftests/post_build namespaces

DEPS = libcap

ADD_CONFIG = ${BUILD_DIR}/tools/testing/selftests/namespaces/config

TEST_START IF ${TEST} == all
TEST_TYPE = test
TEST_BIN = cd .. && ./run_kselftest.sh -c namespaces
TEST = ${DO_TEST_SIMPLE}

TEST_START IF ${TEST} == all-tw
TEST_TYPE = test
TEST_BIN = cd .. && ./run_kselftest.sh -c namespaces
TEST = ${DO_TEST_SIMPLE}
ADD_CONFIG =
BUILD_TYPE = useconfig:${KSOURCE_GIT}/stable/config/x86_64/default
