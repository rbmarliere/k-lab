#!/bin/bash -eu

# k-lab assumes the ROOTFS (or host) has already been set up with everything
# a test needs. This only checks that DEPS are present and fails loudly
# listing what is missing; it never installs or modifies anything.

declare -A fallback_map_files=()
declare -a pkg_files=()
lookup_package_result=

if [[ $# -eq 0 ]]; then
	exit 0
fi

die() {
	echo "ERROR: $*" >&2
	exit 1
}

use_root_install() {
	[[ -n ${ROOT-} ]] || return 1
	if [[ ${BUILD_IN_ROOT:-0} == 1 ]]; then
		return 0
	fi

	! "$BIN"/cross is-foreign "${ARCH:-x86_64}"
}

lookup_package() {
	local dep=$1
	local map_file pkg
	local map_names=()

	for map_file in "${pkg_files[@]}"; do
		map_names+=("$(basename "$map_file")")
		if [[ -e $map_file ]] && pkg=$(
			awk -v key="$dep" '
			$0 ~ /^[[:space:]]*#/ || NF == 0 { next }
			$1 == key {
				found = 1
				if (NF >= 2) {
					print $2
				}
				exit
			}
			END {
				if (!found) {
					exit 1
				}
			}
		' "$map_file"
		); then
			lookup_package_result=$pkg
			return 0
		fi
	done

	fallback_map_files[$dep]="${map_names[*]}"
	lookup_package_result=$dep
}

warn_fallback_packages() {
	local pkg

	for pkg in "$@"; do
		[[ -n ${fallback_map_files[$pkg]+x} ]] || continue
		echo "WARN: dependency '$pkg' is not mapped in ${fallback_map_files[$pkg]}; using '$pkg' as the package name" >&2
	done
}

check() {
	if use_root_install; then
		"$BIN"/rootfs/run "$@"
	else
		"$@"
	fi
}

ID=
ID_LIKE=
VERSION_ID=
etc_dir=/etc
if use_root_install; then
	# Check against this run's private overlay view of ROOT, never ROOT
	# itself (see rootfs_overlay_paths in bin/env.sh).
	"$BIN"/rootfs/mount-overlay
	etc_dir=$TMP_DIR/rootfs/merged/etc
fi

if [[ -r $etc_dir/os-release ]]; then
	# shellcheck disable=SC1090
	. "$etc_dir/os-release"
elif [[ -r $etc_dir/debian_version ]]; then
	ID=debian
	VERSION_ID=$(<"$etc_dir/debian_version")
elif [[ -r $etc_dir/SuSE-release ]]; then
	ID=sles
else
	die "unable to detect distro under $etc_dir"
fi

case "$ID" in
debian | opensuse-tumbleweed | sles)
	;;
*)
	case " ${ID_LIKE-} " in
	*" suse "*)
		ID=sles
		;;
	esac
	;;
esac

case "$ID" in
debian)
	pkg_files=("$BIN"/../pkg/debian)
	check_cmd=(dpkg -s)
	;;
opensuse-tumbleweed)
	pkg_files=("$BIN"/../pkg/tumbleweed)
	check_cmd=(rpm -q --whatprovides)
	;;
sles)
	case "${VERSION_ID:-}" in
	12*)
		pkg_files=("$BIN"/../pkg/sles12 "$BIN"/../pkg/sles "$BIN"/../pkg/tumbleweed)
		;;
	*)
		pkg_files=("$BIN"/../pkg/sles "$BIN"/../pkg/tumbleweed)
		;;
	esac
	check_cmd=(rpm -q --whatprovides)
	;;
*)
	die "unsupported distro ID=$ID"
	;;
esac

for pkg_file in "${pkg_files[@]}"; do
	if [[ ! -e $pkg_file ]]; then
		echo "WARN: File not found: $pkg_file" >&2
	fi
done

packages=()
for dep in "$@"; do
	lookup_package "$dep"
	[[ -n $lookup_package_result ]] && packages+=("$lookup_package_result")
done

mapfile -t packages < <(printf '%s\n' "${packages[@]}" | sort -u)

warn_fallback_packages "${packages[@]}"

missing=()
for pkg in "${packages[@]}"; do
	if ! check "${check_cmd[@]}" "$pkg" >/dev/null 2>&1; then
		missing+=("$pkg")
	fi
done

if [[ ${#missing[@]} -gt 0 ]]; then
	echo "ERROR: missing dependency packages: ${missing[*]}" >&2
	echo "ERROR: k-lab assumes ROOT (or the host) is already fully set up; install these packages there before running tests" >&2
	exit 1
fi

echo "All dependencies already installed!"
