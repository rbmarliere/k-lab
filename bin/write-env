#!/usr/bin/env bash

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# Source env.sh for the canonical KLAB_ENV_KEYS list. This also recomputes the
# path vars (BIN/TOOLS_DIR/VNG_DIR), matching what hooks/pre-ktest already did
# before invoking write-env, so the persisted values are unchanged.
# shellcheck disable=SC1091
source "$THIS_DIR/env.sh"

[[ -n ${TMP_DIR-} ]] || {
	echo "ERROR: TMP_DIR is not set" >&2
	exit 1
}

env_file=$TMP_DIR/env.sh
{
	printf '#!/usr/bin/env bash\n'
	for key in "${KLAB_ENV_KEYS[@]}"; do
		if [[ -n ${!key-} ]]; then
			printf 'export %s=%q\n' "$key" "${!key}"
		else
			printf 'unset %s\n' "$key"
		fi
	done
} >"$env_file"
