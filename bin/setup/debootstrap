#!/bin/bash -eu

# Runs fully unprivileged via two different mechanisms, used for two
# different privilege needs (see plans/02-setup-scripts-fakeroot-unshare.md):
#
#  - Package unpacking (both debootstrap's own first stage and apt-get
#    installs done later inside the chroot) chown()s files from package
#    metadata, including to system group ids k-lab has no reason to own
#    (e.g. Debian's unix_chkpwd ships root:shadow) -- not just uid 0/gid 0.
#    A mapped-root user namespace (unshare --map-root-user) only maps a
#    SINGLE id, so chown() to any other id fails with EINVAL (the kernel
#    can't translate an id with no mapping at all -- see user_namespaces(7)
#    -- not EPERM), which fakeroot does not swallow (it only swallows the
#    EPERM an unprivileged chown gets in a normal, unrestricted namespace).
#    So package unpacking instead runs under `fakeroot` directly, in the
#    real (unrestricted) namespace, exactly like bin/setup/suse-bootstrap.
#  - The actual chroot(2) syscall (second stage, apt-get install, the -e
#    extra command) needs real CAP_SYS_CHROOT, which fakeroot cannot fake
#    (unlike fakechroot, this deliberately uses a REAL chroot -- see the
#    plan for why). That runs inside a mapped-root user namespace instead
#    (run_chroot() below), which is unrelated to and does not conflict with
#    the fakeroot use above since it wraps a separate, later command.
#
# debootstrap's own first stage never calls chroot(), and second stage is
# the only phase that does ("first stage sets up the chroot -- no calls
# should be made to chroot $TARGET here", per debootstrap's own functions
# script) -- but only when split via --foreign/--second-stage. A plain,
# single-invocation (non-foreign) debootstrap run interleaves both in one
# process, which cannot satisfy both privilege needs above at once. So this
# script always uses --foreign, then always runs the second stage itself,
# even for a native-arch target.
HOST_ARCH=
SUITE=sid
ROOT=
ARCH=
EXEC=
MIRROR=
DEBOOTSTRAP=

usage() {
	cat <<'EOF'
usage: debootstrap [options] ROOT

Create a Debian rootfs tree for k-lab and apply the default post-install tweaks.

options:
  -h        show this help
  -s SUITE  Debian suite to bootstrap (default: sid)
  -a ARCH   target architecture; accepts k-lab names such as x86_64, arm64,
            arm, powerpc, s390, and riscv
  -e CMD    extra command to run inside the rootfs after bootstrap
  -A        use archive.debian.org for old Debian releases
EOF
}

die() {
	echo "ERROR: $*" >&2
	exit 1
}

need_cmd() {
	command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

normalize_arch() {
	case "${1-}" in
	"" | x86_64 | amd64 | x86)
		printf '%s\n' x86_64
		;;
	aarch64 | arm64)
		printf '%s\n' arm64
		;;
	arm | armhf)
		printf '%s\n' arm
		;;
	powerpc | ppc64 | ppc64el | ppc64le)
		printf '%s\n' powerpc
		;;
	s390 | s390x)
		printf '%s\n' s390
		;;
	riscv | riscv64)
		printf '%s\n' riscv
		;;
	*)
		die "unsupported architecture: $1"
		;;
	esac
}

debootstrap_arch() {
	case "$1" in
	x86_64)
		printf '%s\n' amd64
		;;
	arm64)
		printf '%s\n' arm64
		;;
	arm)
		printf '%s\n' armhf
		;;
	powerpc)
		printf '%s\n' ppc64el
		;;
	s390)
		printf '%s\n' s390x
		;;
	riscv)
		printf '%s\n' riscv64
		;;
	*)
		die "unsupported architecture: $1"
		;;
	esac
}

ensure_target_root() {
	ROOT=$(realpath -m -- "$ROOT")

	if [[ -e $ROOT && ! -d $ROOT ]]; then
		die "ROOT exists but is not a directory: $ROOT"
	fi

	if [[ -d $ROOT ]] && find "$ROOT" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
		die "ROOT already exists and is not empty: $ROOT"
	fi

	mkdir -p -- "$ROOT"
}

# The only unprivileged way to get a real chroot(2): a mapped-root user
# namespace (ns-uid 0, mapped back to the real invoking uid -- see the
# top-of-file comment). A fresh namespace per call is fine here: unlike
# bin/chroot/*'s persistent per-build overlay, there is no expensive mount
# state worth keeping alive across these one-shot calls.
run_chroot() {
	unshare --user --pid --mount --map-root-user --fork -- chroot "$@"
}

run_second_stage() {
	if ! run_chroot "$ROOT" /bin/sh -c 'true' >/dev/null 2>&1; then
		die "second stage requires a working chroot (for a foreign target: binfmt_misc plus qemu-user support on the host)"
	fi

	run_chroot "$ROOT" /debootstrap/debootstrap --second-stage
}

run_debootstrap() {
	local deb_arch=$1
	local -a args=(--arch "$deb_arch" --foreign)

	args+=("$SUITE" "$ROOT")
	if [[ -n $MIRROR ]]; then
		args+=("$MIRROR")
	fi

	# --foreign: only unpack here, no chroot (see top-of-file comment). Runs
	# under fakeroot, in the real namespace, so chown() during unpacking
	# faithfully gets (and fakeroot correctly swallows) EPERM for any id,
	# not just uid/gid 0.
	fakeroot -- "$DEBOOTSTRAP" "${args[@]}"
	run_second_stage
}

install_guest_packages() {
	run_chroot "$ROOT" /bin/sh -lc \
		'yes | DEBIAN_FRONTEND=noninteractive apt-get install -yqq --allow-unauthenticated openssh-server'
}

run_extra_command() {
	[[ -n $EXEC ]] || return 0

	run_chroot "$ROOT" /bin/bash -ilc "$EXEC"
}

write_resolv_conf() {
	tee "$ROOT/etc/resolv.conf" >/dev/null <<'EOF'
nameserver 10.0.2.3
nameserver 8.8.8.8
EOF
}

run_post_install() {
	install_guest_packages
	run_extra_command
	write_resolv_conf
}

while getopts "hs:a:e:A" opt; do
	case "$opt" in
	h)
		usage
		exit 0
		;;
	s)
		SUITE=$OPTARG
		;;
	a)
		ARCH=$(normalize_arch "$OPTARG")
		;;
	e)
		EXEC=$OPTARG
		;;
	A)
		MIRROR=http://archive.debian.org/debian
		;;
	*)
		usage >&2
		exit 1
		;;
	esac
done

shift $((OPTIND - 1))
[[ $# -le 1 ]] || die "unexpected extra arguments: $*"
if [[ $# -eq 1 ]]; then
	ROOT=$1
fi

need_cmd realpath
need_cmd chroot
need_cmd tee
need_cmd fakeroot
need_cmd unshare

DEBOOTSTRAP=$(command -v debootstrap || true)
[[ -n $DEBOOTSTRAP ]] || die "missing required command: debootstrap"

command -v dpkg >/dev/null 2>&1 || die "missing required command: dpkg"

HOST_ARCH=$(normalize_arch "$(uname -m)")
ARCH=${ARCH:-$HOST_ARCH}

[[ -n $ROOT ]] || die "no target path specified"

ensure_target_root
run_debootstrap "$(debootstrap_arch "$ARCH")"
run_post_install

printf 'Debootstrap rootfs ready at %s (%s, %s)\n' "$ROOT" "$SUITE" "$ARCH"
