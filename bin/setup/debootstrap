#!/bin/bash -eu

HOST_ARCH=
SUITE=sid
ROOT=
ARCH=
EXEC=
MIRROR=
DEBOOTSTRAP=

usage() {
	cat <<'EOF'
usage: debootstrap [options]

Create a Debian rootfs tree for k-lab and apply the default post-install tweaks.

options:
  -h        show this help
  -s SUITE  Debian suite to bootstrap (default: sid)
  -r ROOT   target rootfs directory
  -a ARCH   target architecture; accepts k-lab names such as x86_64, arm64,
            arm, powerpc, s390, and riscv
  -e CMD    extra command to run inside the rootfs after bootstrap
  -A        use archive.debian.org for old Debian releases
EOF
}

die() {
	echo "ERROR: $*" >&2
	exit 1
}

need_cmd() {
	command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

normalize_arch() {
	case "${1-}" in
	"" | x86_64 | amd64 | x86)
		printf '%s\n' x86_64
		;;
	aarch64 | arm64)
		printf '%s\n' arm64
		;;
	arm | armhf)
		printf '%s\n' arm
		;;
	powerpc | ppc64 | ppc64el | ppc64le)
		printf '%s\n' powerpc
		;;
	s390 | s390x)
		printf '%s\n' s390
		;;
	riscv | riscv64)
		printf '%s\n' riscv
		;;
	*)
		die "unsupported architecture: $1"
		;;
	esac
}

debootstrap_arch() {
	case "$1" in
	x86_64)
		printf '%s\n' amd64
		;;
	arm64)
		printf '%s\n' arm64
		;;
	arm)
		printf '%s\n' armhf
		;;
	powerpc)
		printf '%s\n' ppc64el
		;;
	s390)
		printf '%s\n' s390x
		;;
	riscv)
		printf '%s\n' riscv64
		;;
	*)
		die "unsupported architecture: $1"
		;;
	esac
}

ensure_target_root() {
	ROOT=$(realpath -m -- "$ROOT")

	if [[ -e $ROOT && ! -d $ROOT ]]; then
		die "ROOT exists but is not a directory: $ROOT"
	fi

	if [[ -d $ROOT ]] && find "$ROOT" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
		die "ROOT already exists and is not empty: $ROOT"
	fi

	mkdir -p -- "$ROOT"
}

run_second_stage() {
	if ! sudo chroot "$ROOT" /bin/sh -c 'true' >/dev/null 2>&1; then
		die "foreign second stage requires binfmt_misc plus qemu-user support on the host"
	fi

	sudo chroot "$ROOT" /debootstrap/debootstrap --second-stage
}

run_debootstrap() {
	local deb_arch=$1
	local -a args=(--arch "$deb_arch")

	if [[ $ARCH != "$HOST_ARCH" ]]; then
		args+=(--foreign)
	fi

	args+=("$SUITE" "$ROOT")
	if [[ -n $MIRROR ]]; then
		args+=("$MIRROR")
	fi

	sudo "$DEBOOTSTRAP" "${args[@]}"

	if [[ $ARCH != "$HOST_ARCH" ]]; then
		run_second_stage
	fi
}

install_guest_packages() {
	sudo chroot "$ROOT" /bin/sh -lc \
		'yes | DEBIAN_FRONTEND=noninteractive apt-get install -yqq --allow-unauthenticated linux-image-generic openssh-server'
}

run_extra_command() {
	[[ -n $EXEC ]] || return 0

	sudo chroot "$ROOT" /bin/bash -ilc "$EXEC"
}

write_resolv_conf() {
	sudo tee "$ROOT/etc/resolv.conf" >/dev/null <<'EOF'
nameserver 10.0.2.3
nameserver 8.8.8.8
EOF
}

fix_ownership() {
	local owner=${SUDO_USER:-$USER}

	sudo chown -R -- "$owner:$owner" "$ROOT"
}

run_post_install() {
	install_guest_packages
	run_extra_command
	write_resolv_conf
	fix_ownership
}

while getopts "hs:r:a:e:A" opt; do
	case "$opt" in
	h)
		usage
		exit 0
		;;
	s)
		SUITE=$OPTARG
		;;
	r)
		ROOT=$OPTARG
		;;
	a)
		ARCH=$(normalize_arch "$OPTARG")
		;;
	e)
		EXEC=$OPTARG
		;;
	A)
		MIRROR=http://archive.debian.org/debian
		;;
	*)
		usage >&2
		exit 1
		;;
	esac
done

need_cmd sudo
need_cmd realpath
need_cmd chroot
need_cmd tee

DEBOOTSTRAP=$(command -v debootstrap || true)
[[ -n $DEBOOTSTRAP ]] || die "missing required command: debootstrap"

command -v dpkg >/dev/null 2>&1 || die "missing required command: dpkg"

HOST_ARCH=$(normalize_arch "$(uname -m)")
ARCH=${ARCH:-$HOST_ARCH}

[[ -n $ROOT ]] || die "no target path specified"

ensure_target_root
run_debootstrap "$(debootstrap_arch "$ARCH")"
run_post_install

printf 'Debootstrap rootfs ready at %s (%s, %s)\n' "$ROOT" "$SUITE" "$ARCH"
