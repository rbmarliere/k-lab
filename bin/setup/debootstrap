#!/usr/bin/env bash

# Runs fully unprivileged via two mechanisms, one per privilege need (see
# plans/02-setup-scripts-fakeroot-unshare.md):
#
#  - Package unpacking (first stage and any later apt-get installs) chowns
#    files to arbitrary system group ids (e.g. Debian's unix_chkpwd ships
#    root:shadow), not just uid/gid 0. A mapped-root user namespace only
#    maps a single id, so chown() to any other id fails with EINVAL, which
#    fakeroot does not swallow (it only swallows a normal EPERM). So
#    unpacking runs under `fakeroot` directly, like suse-bootstrap.
#  - The real chroot(2) (second stage, apt-get install, -e) needs
#    CAP_SYS_CHROOT, which fakeroot cannot fake. That runs inside a
#    mapped-root user namespace instead (run_chroot() below).
#
# debootstrap's first stage never chroots; second stage does, but only
# when split via --foreign/--second-stage. So this script always uses
# --foreign and runs the second stage itself, even for native arch, to
# keep the two privilege mechanisms separated.
HOST_ARCH=
SUITE=sid
ROOT=
ARCH=
EXEC=
MIRROR=
DEBOOTSTRAP=

usage() {
	cat <<'EOF'
usage: debootstrap [options] ROOT

Create a Debian rootfs tree for k-lab and apply the default post-install tweaks.

options:
  -h        show this help
  -s SUITE  Debian suite to bootstrap (default: sid)
  -a ARCH   target architecture; accepts k-lab names such as x86_64, arm64,
            arm, powerpc, s390, and riscv
  -e CMD    extra command to run inside the rootfs after bootstrap
  -A        use archive.debian.org for old Debian releases
EOF
}

die() {
	echo "ERROR: $*" >&2
	exit 1
}

need_cmd() {
	command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

normalize_arch() {
	case "${1-}" in
	"" | x86_64 | amd64 | x86)
		printf '%s\n' x86_64
		;;
	aarch64 | arm64)
		printf '%s\n' arm64
		;;
	arm | armhf)
		printf '%s\n' arm
		;;
	powerpc | ppc64 | ppc64el | ppc64le)
		printf '%s\n' powerpc
		;;
	s390 | s390x)
		printf '%s\n' s390
		;;
	riscv | riscv64)
		printf '%s\n' riscv
		;;
	*)
		die "unsupported architecture: $1"
		;;
	esac
}

debootstrap_arch() {
	case "$1" in
	x86_64)
		printf '%s\n' amd64
		;;
	arm64)
		printf '%s\n' arm64
		;;
	arm)
		printf '%s\n' armhf
		;;
	powerpc)
		printf '%s\n' ppc64el
		;;
	s390)
		printf '%s\n' s390x
		;;
	riscv)
		printf '%s\n' riscv64
		;;
	*)
		die "unsupported architecture: $1"
		;;
	esac
}

ensure_target_root() {
	ROOT=$(realpath -m -- "$ROOT")

	if [[ -e $ROOT && ! -d $ROOT ]]; then
		die "ROOT exists but is not a directory: $ROOT"
	fi

	if [[ -d $ROOT ]] && find "$ROOT" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
		die "ROOT already exists and is not empty: $ROOT"
	fi

	mkdir -p -- "$ROOT"
}

# Unprivileged real chroot(2) via a mapped-root user namespace (see the
# top-of-file comment). A fresh namespace per call is fine: unlike
# bin/chroot/*'s persistent overlay, there is no state worth keeping alive
# across these one-shot calls.
run_chroot() {
	unshare --user --pid --mount --map-root-user --fork -- chroot "$@"
}

run_second_stage() {
	if ! run_chroot "$ROOT" /bin/sh -c 'true' >/dev/null 2>&1; then
		die "second stage requires a working chroot (for a foreign target: binfmt_misc plus qemu-user support on the host)"
	fi

	run_chroot "$ROOT" /debootstrap/debootstrap --second-stage
}

run_debootstrap() {
	local deb_arch=$1
	local -a args=(--arch "$deb_arch" --foreign)

	args+=("$SUITE" "$ROOT")
	if [[ -n $MIRROR ]]; then
		args+=("$MIRROR")
	fi

	# --foreign: only unpack here, no chroot (see top-of-file comment).
	fakeroot -- "$DEBOOTSTRAP" "${args[@]}"
	run_second_stage
}

install_guest_packages() {
	run_chroot "$ROOT" /bin/sh -lc \
		'yes | DEBIAN_FRONTEND=noninteractive apt-get install -yqq --allow-unauthenticated openssh-server'
}

run_extra_command() {
	[[ -n $EXEC ]] || return 0

	run_chroot "$ROOT" /bin/bash -ilc "$EXEC"
}

write_resolv_conf() {
	tee "$ROOT/etc/resolv.conf" >/dev/null <<'EOF'
nameserver 10.0.2.3
nameserver 8.8.8.8
EOF
}

run_post_install() {
	install_guest_packages
	run_extra_command
	write_resolv_conf
}

while getopts "hs:a:e:A" opt; do
	case "$opt" in
	h)
		usage
		exit 0
		;;
	s)
		SUITE=$OPTARG
		;;
	a)
		ARCH=$(normalize_arch "$OPTARG")
		;;
	e)
		EXEC=$OPTARG
		;;
	A)
		MIRROR=http://archive.debian.org/debian
		;;
	*)
		usage >&2
		exit 1
		;;
	esac
done

shift $((OPTIND - 1))
[[ $# -le 1 ]] || die "unexpected extra arguments: $*"
if [[ $# -eq 1 ]]; then
	ROOT=$1
fi

need_cmd realpath
need_cmd chroot
need_cmd tee
need_cmd fakeroot
need_cmd unshare

DEBOOTSTRAP=$(command -v debootstrap || true)
[[ -n $DEBOOTSTRAP ]] || die "missing required command: debootstrap"

command -v dpkg >/dev/null 2>&1 || die "missing required command: dpkg"

HOST_ARCH=$(normalize_arch "$(uname -m)")
ARCH=${ARCH:-$HOST_ARCH}

[[ -n $ROOT ]] || die "no target path specified"

ensure_target_root
run_debootstrap "$(debootstrap_arch "$ARCH")"
run_post_install

printf 'Debootstrap rootfs ready at %s (%s, %s)\n' "$ROOT" "$SUITE" "$ARCH"
