#!/bin/bash -eu

ROOT=${ROOT:-/roots/tumbleweed}
ZYPP_CONF_PATH=$ROOT/etc/zypp
CALLER=${SUDO_USER:-$(id -un)}

if [[ $(id -u) -gt 0 ]]; then
	echo "ERROR: need uid=0"
	exit 1
fi
if [[ -e $ROOT ]]; then
	echo "ERROR: file exists ($ROOT)"
	exit 1
fi

mkdir -p \
  "$ZYPP_CONF_PATH/repos.d" \
  "$ZYPP_CONF_PATH/services.d" \
  "$ZYPP_CONF_PATH/vars.d" \
  "$ROOT/var/cache/zypp"

tee "$ZYPP_CONF_PATH/zypp.conf.klab" >/dev/null <<EOF
[main]
configdir = $ZYPP_CONF_PATH
reposdir = $ZYPP_CONF_PATH/repos.d
servicesdir = $ZYPP_CONF_PATH/services.d
varsdir = $ZYPP_CONF_PATH/vars.d
cachedir = $ROOT/var/cache/zypp
solver.onlyRequires = true
installRecommends = false
EOF

zyp() {
	cmd=(env ZYPP_CONF="$ZYPP_CONF_PATH/zypp.conf.klab" zypper --non-interactive --root "$ROOT" "$@")
	echo "${cmd[@]}"
	"${cmd[@]}"
}

release_pkg=openSUSE-release
extra_pkg=(aaa_base busybox coreutils iproute2 util-linux zypper)

if [[ ! -t 0 ]]; then
	while IFS= read -r line || [[ -n $line ]]; do
		[[ $line =~ ^[[:space:]]*($|#) ]] && continue

		read -r -a repo_args <<<"$line"
		zyp addrepo --refresh --no-gpgcheck "${repo_args[@]}"
		release_pkg=sles-release
	done
fi

if [[ $release_pkg == openSUSE-release ]]; then
	zyp addrepo --refresh --no-gpgcheck \
		https://download.opensuse.org/tumbleweed/repo/oss/ opensuse
	extra_pkg+=(ca-certificates-mozilla coreutils gawk grep gzip sed xz)
fi

set +e

zyp install "$release_pkg" "${extra_pkg[@]}"

chown -R "$CALLER":"$CALLER" "$ROOT"

# remove setuid from /bin/mount and others, so vng boots with unshare
find "$ROOT" -xdev -perm /6000 -exec chmod -s {} \;
