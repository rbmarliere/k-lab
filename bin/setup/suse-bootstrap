#!/bin/bash -eu

ROOT=${ROOT:-/roots/tumbleweed}
ZYPP_CONF_PATH=$ROOT/etc/zypp

if [[ $(id -u) -gt 0 ]]; then
	echo "ERROR: need uid=0"
	exit 1
fi
if [[ -e $ROOT ]]; then
	echo "ERROR: file exists ($ROOT)"
	exit 1
fi

mkdir -p \
  "$ZYPP_CONF_PATH/repos.d" \
  "$ZYPP_CONF_PATH/services.d" \
  "$ZYPP_CONF_PATH/vars.d" \
  "$ROOT/var/cache/zypp"

tee "$ZYPP_CONF_PATH/zypp.conf.klab" >/dev/null <<EOF
[main]
configdir = $ZYPP_CONF_PATH
reposdir = $ZYPP_CONF_PATH/repos.d
servicesdir = $ZYPP_CONF_PATH/services.d
varsdir = $ZYPP_CONF_PATH/vars.d
cachedir = $ROOT/var/cache/zypp
solver.onlyRequires = true
installRecommends = false
EOF

zyp() {
	cmd=(env ZYPP_CONF="$ZYPP_CONF_PATH/zypp.conf.klab" zypper --non-interactive --root "$ROOT" "$@")
	echo "${cmd[@]}"
	"${cmd[@]}"
}

write_zypper_helper() {
	cat >"$ROOT/zypper" <<EOF
#!/bin/bash
ROOT=\$(dirname -- "\$(realpath -- "\${BASH_SOURCE[0]}")")
sudo env ZYPP_CONF="\$ROOT/etc/zypp/zypp.conf.klab" zypper --non-interactive --root "\$ROOT" "\$@"
EOF
	chmod +x "$ROOT/zypper"
}

fix_ownership() {
	[[ -d $ROOT ]] || return 0
	local owner=${SUDO_USER:-$USER}
	chown -R -- "$owner:$owner" "$ROOT"
}

on_exit() {
	local status=$?
	if ! fix_ownership; then
		echo "WARN: failed to fix ownership: $ROOT" >&2
	fi
	# remove setuid from /bin/mount and others, so vng boots with unshare
	find "$ROOT" -xdev -perm /6000 -exec chmod -s {} \;
	return "$status"
}

pkg=(aaa_base busybox coreutils iproute2 util-linux zypper)
repos=(
	"https://download.opensuse.org/tumbleweed/repo/oss/ opensuse"
)
use_default_repos=1
if [[ -n ${EXTRA-} ]]; then
	read -r -a extra_pkg <<<"$EXTRA"
	pkg+=("${extra_pkg[@]}")
fi

if [[ ! -t 0 ]]; then
	stdin_repos=()
	while IFS= read -r line || [[ -n $line ]]; do
		[[ $line =~ ^[[:space:]]*($|#) ]] && continue

		stdin_repos+=("$line")
	done
	if [[ ${#stdin_repos[@]} -gt 0 ]]; then
		repos=("${stdin_repos[@]}")
		use_default_repos=0
	fi
fi

if [[ $use_default_repos == 1 ]]; then
	pkg+=(ca-certificates-mozilla coreutils gawk grep gzip sed system-group-hardware xz)
fi

for repo in "${repos[@]}"; do
	read -r -a repo_args <<<"$repo"
	zyp addrepo --refresh --no-gpgcheck "${repo_args[@]}"
done

trap on_exit EXIT

zyp install "${pkg[@]}"
write_zypper_helper

echo "To install more packages later, use: $ROOT/zypper install PACKAGE..."
