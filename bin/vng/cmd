#!/bin/bash -eu

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/../env.sh"

VNG_ROOT="${1:?usage: cmd \$ROOTFS [vng-args...] [-- cmd...]}"
shift

VNG_ROOT=$(realpath "$VNG_ROOT")
if [[ ! -d $VNG_ROOT ]]; then
	echo "$VNG_ROOT: no such directory" >&2
	exit 1
fi

# Split the caller's remaining args at the first literal "--": everything
# before it are vng flags, everything after (if anything) is the command
# the caller wants to run.
pre_args=()
post_args=()
have_dashdash=
for arg in "$@"; do
	if [[ -z $have_dashdash && $arg == "--" ]]; then
		have_dashdash=1
		continue
	fi
	if [[ -n $have_dashdash ]]; then
		post_args+=("$arg")
	else
		pre_args+=("$arg")
	fi
done

resolved_arch=$("$BIN"/cross resolve-arch "$VNG_ROOT" "${ARCH-}")
"$BIN"/cross preflight-vng "$VNG_ROOT" "$resolved_arch"

arch_args=(
	--busybox "$("$BIN"/cross busybox-path "$resolved_arch")"
	--qemu "$("$BIN"/cross qemu-bin-path "$resolved_arch")"
)
if "$BIN"/cross is-foreign "$resolved_arch"; then
	cross_compile=$("$BIN"/cross cross-compile "$resolved_arch")
	arch_args+=(--arch "$("$BIN"/cross vng-arch "$resolved_arch")")
	if [[ -n $cross_compile ]]; then
		arch_args+=(--cross-compile "$cross_compile")
	fi
fi

vng_port=${VNG_PORT:-$((22000 + RANDOM % 1001))}
# Automated runs (start-vm) always have a per-run TMP_DIR, so key the helper
# off that (stable, unique per run) instead of cwd + rootfs basename (cwd is
# typically the shared kernel tree, and every start-vm run's VNG_ROOT is the
# same "merged" overlay path, so a cwd-relative name would collide across
# concurrent runs). Fall back to a cwd-relative name for standalone,
# interactive use with no TMP_DIR.
if [[ -n ${TMP_DIR-} ]]; then
	ssh_helper="$TMP_DIR/vng.ssh"
else
	ssh_helper="ssh-$(basename -- "$VNG_ROOT")"
fi
trap 'rm -f -- "$ssh_helper"' EXIT

export PATH="$VNG_DIR:$VNG_DIR/virtme/guest/bin:$PATH"

# Reconnect/exec-into-guest helper: since ROOT is root-owned, both this boot
# and any later SSH connection must run as real root (via bin/run --as-root)
# so they agree on the same $HOME-derived SSH cache/identity files (see
# virtme_ng.utils.CACHE_DIR) -- sudo's "always_set_home" means a root-owned
# boot and a non-root client would otherwise resolve to two different (and
# mismatched) cache directories. Forward "$@" as-is (rather than collapsing
# to a single --remote-cmd string) so vng's own quoting (shlex.join) handles
# multi-word/pre-quoted commands correctly.
{
	printf '#!/bin/bash -eu\n'
	printf '%q --as-root --preserve-env=PATH -- %q --root %q --user root --ssh-tcp --ssh-client %q -- "$@"\n' \
		"$BIN/run" "$VNG_DIR/vng" "$VNG_ROOT" "$vng_port"
} >"$ssh_helper"
chmod +x "$ssh_helper"

set \
	-- \
	--root "$VNG_ROOT" \
	--rw \
	--user root \
	--verbose \
	--network user \
	--no-virtme-ng-init \
	--ssh-tcp \
	--ssh "$vng_port" \
	--memory "${VNG_MEM:-8G}" \
	--disable-microvm \
	"${arch_args[@]}" \
	"${pre_args[@]}"

if [[ -n $have_dashdash ]]; then
	set -- "$@" -- "${post_args[@]}"
fi

set -x
"$BIN"/run --as-root --preserve-env=PATH -- "$VNG_DIR/vng" "$@"
