#!/usr/bin/env bash

root_disk=$(realpath "$ROOT_DISK")

set -- \
	--run "$OUTPUT_DIR" \
	--rwdir "$BUILD_DIR=$BUILD_DIR" \
	--rwdir "$OUTPUT_DIR=$OUTPUT_DIR" \
	"$@"

echo "$BIN/vng/cmd $root_disk $* -- sleep infinity" >"$TMP_DIR"/vng.cmd

"$BIN"/vng/start-console

setsid "$BIN"/vng/cmd "$root_disk" "$@" -- sleep infinity </dev/null &>"$TMP_DIR"/vng.log &
echo $! >"$TMP_DIR"/vng.pid
