#!/bin/bash -eu

has_root=0
for arg in "$@"; do
	if [[ $arg == "--root" ]]; then
		has_root=1
		break
	fi
done

if [[ -n ${ROOT-} && $has_root -eq 0 ]]; then
	set -- \
		--force-9p \
		--user root \
		--root "$ROOT" \
		--rw \
		--rwdir "$BUILD_DIR=$BUILD_DIR" \
		--overlay-rw "$BUILD_DIR" \
		--rwdir "$OUTPUT_DIR=$OUTPUT_DIR" \
		--overlay-rw "$OUTPUT_DIR" \
		"$@"
	has_root=1
fi

set -- \
	--verbose \
	--run "$OUTPUT_DIR" \
	--network user \
	--memory 4G \
	--ssh-tcp \
	--ssh "$VNG_PORT" \
	"$@"

user_root=
rootfs=()
arch_args=()
if [[ $has_root -eq 1 ]]; then
	rootfs=(
		unshare
		--map-root-user
		--map-auto
		--mount
		--
	)
	user_root="--user root"
fi

if "$BIN"/cross is-foreign "${ARCH:-x86_64}"; then
	"$BIN"/cross preflight-vng "${ROOT-}" "${ARCH-}"
	arch_args+=(
		--arch "$("$BIN"/cross vng-arch "${ARCH:-x86_64}")"
		--busybox "$("$BIN"/cross busybox-path "${ARCH:-x86_64}")"
	)
fi

echo "PATH=\"$VNG_DIR:$VNG_DIR/virtme/guest/bin:\$PATH\" ${rootfs[*]} vng ${arch_args[*]} $*" >"$TMP_DIR"/vng.cmd
echo "PATH=\"$VNG_DIR:$VNG_DIR/virtme/guest/bin:\$PATH\" vng --ssh-tcp --ssh-client $VNG_PORT $user_root" >>"$TMP_DIR"/vng.cmd

setsid "${rootfs[@]}" "$BIN"/vng/cmd "${arch_args[@]}" "$@" -- sleep infinity </dev/null &>"$TMP_DIR"/vng.log &
echo $! >"$TMP_DIR"/vng.pid
