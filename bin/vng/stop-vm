#!/usr/bin/env bash

wait_for_group_exit() {
	local pid=$1
	local i

	for ((i = 0; i < 50; i++)); do
		if ! kill -0 -- "-$pid" 2>/dev/null; then
			return 0
		fi
		sleep 0.1
	done

	return 1
}

KILL_CONSOLE=
while getopts "f" opt; do
	case "$opt" in
	f) KILL_CONSOLE=1 ;;
	*) ;;
	esac
done
shift $((OPTIND - 1))

FPID="$TMP_DIR"/vng.pid
if [[ -n $KILL_CONSOLE && -f $TMP_DIR/console.pid ]]; then
	console_pid=$(<"$TMP_DIR"/console.pid)
	kill -- "-${console_pid}" || true
	wait_for_group_exit "$console_pid" || true
	rm -f "$TMP_DIR"/console.pid
fi

if [[ -f $FPID ]]; then
	pid=$(<"$FPID")
	kill -- "-${pid}" || echo "ERROR: vng not running" >&2
	wait_for_group_exit "$pid" || true
	rm -f "$FPID"
fi

exit 0
