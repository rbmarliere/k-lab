#!/bin/bash -eu

wait_for_group_exit() {
	local pid=$1
	local i

	for ((i = 0; i < 50; i++)); do
		if ! kill -0 -- "-$pid" 2>/dev/null; then
			return 0
		fi
		sleep 0.1
	done

	return 1
}

KILL_CONSOLE=
while getopts "f" opt; do
	case "$opt" in
	f) KILL_CONSOLE=1 ;;
	*) ;;
	esac
done
shift $((OPTIND - 1))

FPID="$TMP_DIR"/vng.pid
if [[ -n $KILL_CONSOLE && -f $TMP_DIR/console.pid ]]; then
	console_pid=$(<"$TMP_DIR"/console.pid)
	kill -- "-${console_pid}" || true
	wait_for_group_exit "$console_pid" || true
	rm -f "$TMP_DIR"/console.pid
fi

if [[ -f $FPID ]]; then
	pid=$(<"$FPID")
	kill -- "-${pid}" || echo "ERROR: vng not running" >&2
	wait_for_group_exit "$pid" || true
	rm -f "$FPID"
fi

# Historically (pre sudo-removal) this needed a marker-based fallback kill,
# pkill-ing by ROOT_DISK path in the real qemu process argv: sudo put the
# actual (root-owned) vng/qemu process in its own session, decoupled from
# the "setsid vng/cmd" group vng.pid tracks, so the group kill above alone
# left it running as an orphan. Now that bin/vng/cmd execs vng directly (no
# "$BIN"/run --as-root), nothing forks qemu into a separate session anymore:
# empirically verified with `ps -eo pid,ppid,pgid,sid,cmd --forest` while a
# VM was up -- vng, virtme-run, and the real qemu-system-* process all share
# vng.pid's process group/session -- so the group kill above reaches qemu
# directly and this fallback is dead code. Removed; see plans/01-vng-drop-sudo.md
# for how this was confirmed, if it ever needs to come back.

exit 0
