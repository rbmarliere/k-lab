#!/usr/bin/env bash
# Build complete selftest collections in CHROOT_USER.
set -e

BUILD_DIR=$(realpath -e -- "${BUILD_DIR:?BUILD_DIR is required}")
OUTPUT_DIR=$(realpath -e -- "${OUTPUT_DIR:?OUTPUT_DIR is required}")
export BUILD_DIR OUTPUT_DIR
src=$BUILD_DIR/tools/testing/selftests
read -r -a targets <<< "${SELFTEST_TARGETS:?SELFTEST_TARGETS is required}"
((${#targets[@]})) || {
	echo 'selftests: SELFTEST_TARGETS is empty' >&2
	exit 1
}

for target in "${targets[@]}"; do
	if [[ ! -f $src/$target/Makefile ]]; then
		echo "selftests: unknown collection: $target" >&2
		exit 1
	fi
done

[[ -d $OUTPUT_DIR/usr/include ]] || {
	echo 'selftests: generate UAPI headers with MAKE_CMD first' >&2
	exit 1
}
mk=(make -C "$src")
if [[ -z ${CHROOT_USER-} && -n ${CROSS_COMPILE-} ]]; then
	mk+=("CROSS_COMPILE=$CROSS_COMPILE")
fi
mk+=("$@" O="$OUTPUT_DIR" KDIR="$OUTPUT_DIR" "ARCH=${ARCH:?ARCH is required}"
	"KHDR_INCLUDES=-isystem $OUTPUT_DIR/usr/include"
	"KSFT_INSTALL_PATH=$OUTPUT_DIR/kselftest/kselftest_install"
	SKIP_TARGETS= "TARGETS=${targets[*]}" FORCE_TARGETS=1 install)

unset ARCH CC HOSTCC HOSTCFLAGS CROSS_COMPILE KBUILD_OUTPUT
CHROOT=${CHROOT_USER-} "$BIN"/chroot "${mk[@]}"
