#!/usr/bin/env bash
set -e

command=${1:?usage: cross <command> <arch>}
case ${2:-x86_64} in
x86_64 | amd64 | x86) row='x86_64 amd64 arch/x86/boot/bzImage x86_64' ;;
arm64 | aarch64) row='arm64 arm64 arch/arm64/boot/Image arm64' ;;
arm | armhf | armv7l) row='arm armhf arch/arm/boot/zImage armv7hl' ;;
powerpc | ppc64le | ppc64el) row='powerpc ppc64el vmlinux ppc64le' ;;
s390 | s390x) row='s390 s390x arch/s390/boot/bzImage s390x' ;;
riscv | riscv64) row='riscv riscv64 arch/riscv/boot/Image riscv64' ;;
*)
	echo "unsupported architecture: $2" >&2
	exit 1
	;;
esac
read -r arch vng image suse <<<"$row"

case $command in
normalize-arch) echo "$arch" ;;
vng-arch) echo "$vng" ;;
build-target) echo "$image" ;;
suse-arch) echo "$suse" ;;
busybox-path)
	dir=$(dirname -- "$(dirname -- "$(realpath -- "$0")")")
	echo "${BUSYBOX_DIR:-$dir/tools/busybox-static-builder}/$arch/bin/busybox"
	;;
*)
	echo "unknown command: $command" >&2
	exit 1
	;;
esac
