#!/bin/bash -eu

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/env.sh"

die() {
	echo "ERROR: $*" >&2
	exit 1
}

normalize_arch() {
	case "${1-}" in
	"" | x86_64 | amd64 | x86)
		printf '%s\n' x86_64
		;;
	aarch64 | arm64)
		printf '%s\n' arm64
		;;
	arm | armhf)
		printf '%s\n' arm
		;;
	powerpc | ppc64 | ppc64el | ppc64le)
		printf '%s\n' powerpc
		;;
	s390 | s390x)
		printf '%s\n' s390
		;;
	riscv | riscv64)
		printf '%s\n' riscv
		;;
	*)
		die "unsupported architecture: $1"
		;;
	esac
}

normalize_root_disk() {
	case "${1-}" in
	"" | 0)
		printf '%s\n' ""
		;;
	*)
		printf '%s\n' "$1"
		;;
	esac
}

# Infer an arch from a disk image's filename, e.g. aarch64.img/arm64.img ->
# arm64, s390x.img -> s390, ppc64le.img -> powerpc. ROOT_DISK is a disk image
# (not a directory), so unlike the old directory-rootfs ELF probe, this is a
# naming convention, not a hard filesystem inspection.
disk_arch() {
	local path=$1
	local name stem

	[[ -n $path ]] || return 1

	name=$(basename -- "$path")
	stem=${name%.*}
	case "$stem" in
	x86_64 | amd64 | x86 | aarch64 | arm64 | arm | armhf | powerpc | ppc64 | ppc64el | ppc64le | s390 | s390x | riscv | riscv64)
		normalize_arch "$stem"
		;;
	*)
		return 1
		;;
	esac
}

# Basic sanity check that a directory looks like a usable chroot target
# before an expensive chrooted build is attempted: must have a shell and a C
# compiler somewhere in the usual (usrmerge or not) locations.
preflight_chroot() {
	local dir=$1 shell="" cc=""

	[[ -n $dir ]] || die "missing CHROOT directory"
	[[ -d $dir ]] || die "CHROOT is not a directory: $dir"

	for shell in "$dir"/bin/sh "$dir"/usr/bin/sh; do
		[[ -x $shell ]] && break
		shell=""
	done
	[[ -n $shell ]] || die "CHROOT has no usable shell (checked bin/sh, usr/bin/sh): $dir"

	for cc in "$dir"/usr/bin/gcc "$dir"/usr/bin/cc "$dir"/bin/gcc "$dir"/bin/cc; do
		[[ -x $cc ]] && break
		cc=""
	done
	[[ -n $cc ]] || die "CHROOT has no usable C compiler (checked usr/bin/{gcc,cc}, bin/{gcc,cc}): $dir"
}

# Find a real ELF userspace binary inside CHROOT to inspect (CHROOT has no
# naming convention to rely on, unlike ROOT_DISK's filename), resolving
# symlinks by hand and refusing anything that escapes CHROOT.
probe_chroot_elf() {
	local dir=$1
	local dir_display=$1
	local rel path real

	resolve_path_under_dir() {
		local dir=$1
		local path=$2
		local target subdir
		local depth=0

		while [[ -L $path ]]; do
			((depth++ < 40)) || die "too many symlinks while probing CHROOT=$dir"

			target=$(readlink -- "$path") || die "failed to read symlink: $path"
			if [[ $target == /* ]]; then
				path=$dir$target
				continue
			fi

			subdir=$(dirname -- "$path")
			path=$(realpath -m -- "$subdir/$target")
			case "$path" in
			"$dir" | "$dir"/*)
				;;
			*)
				die "symlink escapes CHROOT=$dir: $path"
				;;
			esac
		done

		printf '%s\n' "$path"
	}

	[[ -n $dir ]] || return 1
	[[ -d $dir ]] || die "CHROOT is not a directory: $dir"
	dir=$(realpath -e -- "$dir") || die "failed to resolve CHROOT=$dir_display"

	for rel in /bin/sh /usr/bin/env /bin/bash /usr/bin/bash /lib/systemd/systemd /sbin/init; do
		path=$dir$rel
		[[ -e $path ]] || continue

		if ! real=$(resolve_path_under_dir "$dir" "$path"); then
			return 1
		fi

		[[ -f $real ]] || continue
		if readelf -h -- "$real" >/dev/null 2>&1; then
			printf '%s\n' "$real"
			return 0
		fi
	done

	die "unable to find an ELF userspace binary under CHROOT=$dir"
}

# Inspect a real ELF binary inside CHROOT to determine its architecture: no
# naming convention to rely on (unlike ROOT_DISK's filename), so this is a
# hard filesystem inspection instead.
chroot_arch() {
	local dir=$1
	local elf machine data

	[[ -n $dir ]] || return 1
	elf=$(probe_chroot_elf "$dir")

	machine=$(
		readelf -h -- "$elf" | awk -F: '
			$1 ~ /Machine/ {
				gsub(/^[[:space:]]+/, "", $2)
				print $2
				exit
			}
		'
	)
	data=$(
		readelf -h -- "$elf" | awk -F: '
			$1 ~ /Data/ {
				gsub(/^[[:space:]]+/, "", $2)
				print $2
				exit
			}
		'
	)

	case "$machine" in
	"Advanced Micro Devices X86-64")
		printf '%s\n' x86_64
		;;
	AArch64)
		printf '%s\n' arm64
		;;
	ARM)
		printf '%s\n' arm
		;;
	PowerPC64)
		case "$data" in
		*little\ endian*)
			printf '%s\n' powerpc
			;;
		*)
			die "unsupported PowerPC CHROOT endianness: $dir"
			;;
		esac
		;;
	"IBM S/390")
		printf '%s\n' s390
		;;
	RISC-V)
		printf '%s\n' riscv
		;;
	*)
		die "unsupported CHROOT architecture '$machine': $dir"
		;;
	esac
}

build_target() {
	local arch

	arch=$(normalize_arch "$1")
	case "$arch" in
	x86_64)
		printf '%s\n' arch/x86/boot/bzImage
		;;
	arm64)
		printf '%s\n' arch/arm64/boot/Image
		;;
	arm)
		printf '%s\n' arch/arm/boot/zImage
		;;
	powerpc)
		printf '%s\n' vmlinux
		;;
	s390)
		printf '%s\n' arch/s390/boot/bzImage
		;;
	riscv)
		printf '%s\n' arch/riscv/boot/Image
		;;
	esac
}

cross_compile_var() {
	case "$1" in
	arm64)
		printf '%s\n' CROSS_COMPILE_ARM64
		;;
	arm)
		printf '%s\n' CROSS_COMPILE_ARM
		;;
	powerpc)
		printf '%s\n' CROSS_COMPILE_POWERPC
		;;
	s390)
		printf '%s\n' CROSS_COMPILE_S390
		;;
	riscv)
		printf '%s\n' CROSS_COMPILE_RISCV
		;;
	*)
		die "unsupported cross-compile architecture: $1"
		;;
	esac
}

cross_compile_default() {
	case "$1" in
	arm64)
		printf '%s\n' /usr/bin/aarch64-suse-linux-
		;;
	arm)
		printf '%s\n' /usr/bin/arm-suse-linux-gnueabi-
		;;
	powerpc)
		printf '%s\n' /usr/bin/powerpc64le-suse-linux-
		;;
	s390)
		printf '%s\n' /usr/bin/s390x-suse-linux-
		;;
	riscv)
		printf '%s\n' /usr/bin/riscv64-suse-linux-
		;;
	*)
		die "unsupported cross-compile architecture: $1"
		;;
	esac
}

cross_compile() {
	local arch key value

	arch=$(normalize_arch "$1")
	case "$arch" in
	x86_64)
		printf '%s\n' ""
		return 0
		;;
	esac

	key=$(cross_compile_var "$arch")
	if [[ -n ${!key-} ]]; then
		printf '%s\n' "${!key}"
		return 0
	fi

	value=$(read_setup_var "$key" || true)
	if [[ -n $value ]]; then
		printf '%s\n' "$value"
		return 0
	fi

	cross_compile_default "$arch"
}

chroot_var() {
	case "$1" in
	x86_64)
		printf '%s\n' CHROOT_X86_64
		;;
	arm64)
		printf '%s\n' CHROOT_ARM64
		;;
	arm)
		printf '%s\n' CHROOT_ARM
		;;
	powerpc)
		printf '%s\n' CHROOT_POWERPC
		;;
	s390)
		printf '%s\n' CHROOT_S390
		;;
	riscv)
		printf '%s\n' CHROOT_RISCV
		;;
	*)
		die "unsupported chroot architecture: $1"
		;;
	esac
}

# Unlike cross_compile, there is no sensible built-in default: prints empty
# if not configured in setup.conf.
chroot_dir() {
	local arch key

	arch=$(normalize_arch "$1")
	key=$(chroot_var "$arch")
	if [[ -n ${!key-} ]]; then
		printf '%s\n' "${!key}"
		return 0
	fi

	read_setup_var "$key" || true
}

vng_arch() {
	local arch

	arch=$(normalize_arch "$1")
	case "$arch" in
	x86_64)
		printf '%s\n' amd64
		;;
	arm64)
		printf '%s\n' arm64
		;;
	arm)
		printf '%s\n' armhf
		;;
	powerpc)
		printf '%s\n' ppc64el
		;;
	s390)
		printf '%s\n' s390x
		;;
	riscv)
		printf '%s\n' riscv64
		;;
	*)
		die "unsupported virtme-ng arch: $arch"
		;;
	esac
}

suse_arch() {
	local arch

	arch=$(normalize_arch "$1")
	case "$arch" in
	x86_64)
		printf '%s\n' x86_64
		;;
	arm64)
		printf '%s\n' arm64
		;;
	powerpc)
		printf '%s\n' ppc64le
		;;
	s390)
		printf '%s\n' s390x
		;;
	*)
		die "unsupported SUSE kernel-source arch: $arch"
		;;
	esac
}

busybox_path() {
	local arch

	arch=$(normalize_arch "$1")
	printf '%s\n' "$TOOLS_DIR/busybox/$arch/bin/busybox"
}

resolve_arch() {
	local root_disk=${1-}
	local arch=${2-}
	local chroot_dir=${3-}

	if [[ -n $arch ]]; then
		normalize_arch "$arch"
		return 0
	fi

	root_disk=$(normalize_root_disk "$root_disk")
	if [[ -n $root_disk ]] && disk_arch "$root_disk" 2>/dev/null; then
		return 0
	fi

	# Fall back to inspecting a real ELF binary under CHROOT: only useful
	# for an explicit "-D CHROOT:=/path" override, since it must already be
	# known by the time ARCH itself is being resolved (setup.conf's
	# CHROOT_<ARCH> auto-selection depends on ARCH, so it cannot feed back
	# into it).
	if [[ -n $chroot_dir ]] && chroot_arch "$chroot_dir" 2>/dev/null; then
		return 0
	fi

	printf '%s\n' x86_64
}

is_foreign() {
	local arch

	arch=$(normalize_arch "$1")
	[[ $arch != x86_64 ]]
}

# Fast fail-fast checks before a build/boot even starts. ROOT_DISK (a disk
# image) may legitimately be unset for build-only tests that never boot a
# VM; in that case bin/vng/cmd itself is the real enforcement point (it
# always requires a valid disk image, whenever it is actually invoked).
preflight_vng() {
	local root_disk=${1-}
	local arch=${2-}
	local busybox

	root_disk=$(normalize_root_disk "$root_disk")
	if [[ -n $root_disk ]]; then
		[[ -f $root_disk ]] || die "ROOT_DISK is not a regular file (expected a disk image): $root_disk"
	fi

	arch=$(normalize_arch "$arch")
	busybox=$(busybox_path "$arch")
	[[ -x $busybox ]] || die "missing static busybox: $busybox (run $THIS_DIR/bin/setup/build-busybox $arch)"
}

usage() {
	cat <<'EOF'
usage: cross <command> [args]

commands:
  build-target <arch>
  busybox-path <arch>
  chroot-arch <dir>
  chroot-dir <arch>
  cross-compile <arch>
  disk-arch <path>
  is-foreign <arch>
  normalize-arch <arch>
  preflight-chroot <dir>
  preflight-vng [root_disk] [arch]
  resolve-arch [root_disk] [arch] [chroot_dir]
  suse-arch <arch>
  vng-arch <arch>
EOF
}

cmd=${1-}
shift || true

case "$cmd" in
build-target)
	[[ $# -eq 1 ]] || die "usage: cross build-target <arch>"
	build_target "$1"
	;;
busybox-path)
	[[ $# -eq 1 ]] || die "usage: cross busybox-path <arch>"
	busybox_path "$1"
	;;
chroot-arch)
	[[ $# -eq 1 ]] || die "usage: cross chroot-arch <dir>"
	chroot_arch "$1"
	;;
chroot-dir)
	[[ $# -eq 1 ]] || die "usage: cross chroot-dir <arch>"
	chroot_dir "$1"
	;;
cross-compile)
	[[ $# -eq 1 ]] || die "usage: cross cross-compile <arch>"
	cross_compile "$1"
	;;
disk-arch)
	[[ $# -eq 1 ]] || die "usage: cross disk-arch <path>"
	disk_arch "$1"
	;;
is-foreign)
	[[ $# -eq 1 ]] || die "usage: cross is-foreign <arch>"
	is_foreign "$1"
	;;
normalize-arch)
	[[ $# -eq 1 ]] || die "usage: cross normalize-arch <arch>"
	normalize_arch "$1"
	;;
preflight-chroot)
	[[ $# -eq 1 ]] || die "usage: cross preflight-chroot <dir>"
	preflight_chroot "$1"
	;;
preflight-vng)
	[[ $# -ge 0 && $# -le 2 ]] || die "usage: cross preflight-vng [root_disk] [arch]"
	preflight_vng "${1-}" "${2-}"
	;;
resolve-arch)
	[[ $# -ge 0 && $# -le 3 ]] || die "usage: cross resolve-arch [root_disk] [arch] [chroot_dir]"
	resolve_arch "${1-}" "${2-}" "${3-}"
	;;
suse-arch)
	[[ $# -eq 1 ]] || die "usage: cross suse-arch <arch>"
	suse_arch "$1"
	;;
vng-arch)
	[[ $# -eq 1 ]] || die "usage: cross vng-arch <arch>"
	vng_arch "$1"
	;;
"" | -h | --help | help)
	usage
	;;
*)
	die "unknown command: $cmd"
	;;
esac
