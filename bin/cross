#!/bin/bash -eu

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/env.sh"

die() {
	echo "ERROR: $*" >&2
	exit 1
}

normalize_arch() {
	case "${1-}" in
	"" | x86_64 | amd64 | x86)
		printf '%s\n' x86_64
		;;
	aarch64 | arm64)
		printf '%s\n' arm64
		;;
	arm | armhf)
		printf '%s\n' arm
		;;
	powerpc | ppc64 | ppc64el | ppc64le)
		printf '%s\n' powerpc
		;;
	s390 | s390x)
		printf '%s\n' s390
		;;
	riscv | riscv64)
		printf '%s\n' riscv
		;;
	*)
		die "unsupported architecture: $1"
		;;
	esac
}

normalize_root() {
	case "${1-}" in
	"" | 0)
		printf '%s\n' ""
		;;
	*)
		printf '%s\n' "$1"
		;;
	esac
}

# Infer an arch from a disk image's filename, e.g. aarch64.img/arm64.img ->
# arm64, s390x.img -> s390, ppc64le.img -> powerpc. ROOT_DISK is now a disk image
# passed to virtme-ng's --root-disk, not a directory, so unlike the old
# directory-rootfs ELF probe below, this is a naming convention, not a hard
# filesystem inspection.
disk_arch() {
	local path=$1
	local name stem

	[[ -n $path ]] || return 1

	name=$(basename -- "$path")
	stem=${name%.*}
	case "$stem" in
	x86_64 | amd64 | x86 | aarch64 | arm64 | arm | armhf | powerpc | ppc64 | ppc64el | ppc64le | s390 | s390x | riscv | riscv64)
		normalize_arch "$stem"
		;;
	*)
		return 1
		;;
	esac
}

build_target() {
	local arch

	arch=$(normalize_arch "$1")
	case "$arch" in
	x86_64)
		printf '%s\n' arch/x86/boot/bzImage
		;;
	arm64)
		printf '%s\n' arch/arm64/boot/Image
		;;
	arm)
		printf '%s\n' arch/arm/boot/zImage
		;;
	powerpc)
		printf '%s\n' vmlinux
		;;
	s390)
		printf '%s\n' arch/s390/boot/bzImage
		;;
	riscv)
		printf '%s\n' arch/riscv/boot/Image
		;;
	esac
}

cross_compile_var() {
	case "$1" in
	arm64)
		printf '%s\n' CROSS_COMPILE_ARM64
		;;
	arm)
		printf '%s\n' CROSS_COMPILE_ARM
		;;
	powerpc)
		printf '%s\n' CROSS_COMPILE_POWERPC
		;;
	s390)
		printf '%s\n' CROSS_COMPILE_S390
		;;
	riscv)
		printf '%s\n' CROSS_COMPILE_RISCV
		;;
	*)
		die "unsupported cross-compile architecture: $1"
		;;
	esac
}

cross_compile_default() {
	case "$1" in
	arm64)
		printf '%s\n' /usr/bin/aarch64-suse-linux-
		;;
	arm)
		printf '%s\n' /usr/bin/arm-suse-linux-gnueabi-
		;;
	powerpc)
		printf '%s\n' /usr/bin/powerpc64le-suse-linux-
		;;
	s390)
		printf '%s\n' /usr/bin/s390x-suse-linux-
		;;
	riscv)
		printf '%s\n' /usr/bin/riscv64-suse-linux-
		;;
	*)
		die "unsupported cross-compile architecture: $1"
		;;
	esac
}

cross_compile() {
	local arch key value

	arch=$(normalize_arch "$1")
	case "$arch" in
	x86_64)
		printf '%s\n' ""
		return 0
		;;
	esac

	key=$(cross_compile_var "$arch")
	value=$(read_setup_var "$key" || true)
	if [[ -n $value ]]; then
		printf '%s\n' "$value"
		return 0
	fi

	cross_compile_default "$arch"
}

vng_arch() {
	local arch

	arch=$(normalize_arch "$1")
	case "$arch" in
	x86_64)
		printf '%s\n' amd64
		;;
	arm64)
		printf '%s\n' arm64
		;;
	arm)
		printf '%s\n' armhf
		;;
	powerpc)
		printf '%s\n' ppc64el
		;;
	s390)
		printf '%s\n' s390x
		;;
	riscv)
		printf '%s\n' riscv64
		;;
	*)
		die "unsupported virtme-ng arch: $arch"
		;;
	esac
}

suse_arch() {
	local arch

	arch=$(normalize_arch "$1")
	case "$arch" in
	x86_64)
		printf '%s\n' x86_64
		;;
	arm64)
		printf '%s\n' arm64
		;;
	powerpc)
		printf '%s\n' ppc64le
		;;
	s390)
		printf '%s\n' s390x
		;;
	*)
		die "unsupported SUSE kernel-source arch: $arch"
		;;
	esac
}

busybox_path() {
	local arch

	arch=$(normalize_arch "$1")
	printf '%s\n' "$TOOLS_DIR/busybox/$arch/bin/busybox"
}

probe_root_elf() {
	local root=$1
	local root_display=$1
	local rel path real

	resolve_path_under_root() {
		local root=$1
		local path=$2
		local target dir
		local depth=0

		while [[ -L $path ]]; do
			((depth++ < 40)) || die "too many symlinks while probing ROOT_DISK=$root"

			target=$(readlink -- "$path") || die "failed to read symlink: $path"
			if [[ $target == /* ]]; then
				path=$root$target
				continue
			fi

			dir=$(dirname -- "$path")
			path=$(realpath -m -- "$dir/$target")
			case "$path" in
			"$root" | "$root"/*)
				;;
			*)
				die "symlink escapes ROOT_DISK=$root: $path"
				;;
			esac
		done

		printf '%s\n' "$path"
	}

	[[ -n $root ]] || return 1
	[[ -d $root ]] || die "ROOT_DISK is not a directory: $root"
	root=$(realpath -e -- "$root") || die "failed to resolve ROOT_DISK=$root_display"

	for rel in /bin/sh /usr/bin/env /bin/bash /usr/bin/bash /lib/systemd/systemd /sbin/init; do
		path=$root$rel
		[[ -e $path ]] || continue

		if ! real=$(resolve_path_under_root "$root" "$path"); then
			return 1
		fi

		[[ -f $real ]] || continue
		if readelf -h -- "$real" >/dev/null 2>&1; then
			printf '%s\n' "$real"
			return 0
		fi
	done

	die "unable to find an ELF userspace binary under ROOT_DISK=$root"
}

root_arch() {
	local root=$1
	local elf machine data

	root=$(normalize_root "$root")
	[[ -n $root ]] || return 0
	elf=$(probe_root_elf "$root")

	machine=$(
		readelf -h -- "$elf" | awk -F: '
			$1 ~ /Machine/ {
				gsub(/^[[:space:]]+/, "", $2)
				print $2
				exit
			}
		'
	)
	data=$(
		readelf -h -- "$elf" | awk -F: '
			$1 ~ /Data/ {
				gsub(/^[[:space:]]+/, "", $2)
				print $2
				exit
			}
		'
	)

	case "$machine" in
	"Advanced Micro Devices X86-64")
		printf '%s\n' x86_64
		;;
	AArch64)
		printf '%s\n' arm64
		;;
	ARM)
		printf '%s\n' arm
		;;
	PowerPC64)
		case "$data" in
		*little\ endian*)
			printf '%s\n' powerpc
			;;
		*)
			die "unsupported PowerPC rootfs endianness under ROOT_DISK=$root"
			;;
		esac
		;;
	"IBM S/390")
		printf '%s\n' s390
		;;
	RISC-V)
		printf '%s\n' riscv
		;;
	*)
		die "unsupported ROOT_DISK architecture '$machine' under ROOT_DISK=$root"
		;;
	esac
}

resolve_arch() {
	local root=${1-}
	local arch=${2-}

	if [[ -n $arch ]]; then
		normalize_arch "$arch"
		return 0
	fi

	root=$(normalize_root "$root")
	if [[ -n $root ]] && disk_arch "$root" 2>/dev/null; then
		return 0
	fi

	printf '%s\n' x86_64
}

is_foreign() {
	local arch

	arch=$(normalize_arch "$1")
	[[ $arch != x86_64 ]]
}

preflight_root() {
	local root=${1-}
	local arch=${2-}
	local detected
	local root_uid

	root=$(normalize_root "$root")
	[[ -n $root ]] || return 0
	[[ -d $root ]] || die "ROOT_DISK is not a directory: $root"

	root_uid=$(stat -c %u -- "$root") || die "failed to stat ROOT_DISK: $root"
	[[ $root_uid == 0 ]] || die "ROOT_DISK must be owned by root (uid 0): $root"

	detected=$(root_arch "$root")
	if [[ -n $arch ]]; then
		arch=$(normalize_arch "$arch")
		if [[ $arch != "$detected" ]]; then
			die "ARCH=$arch does not match ROOT_DISK=$root ($detected)"
		fi
	else
		arch=$detected
	fi

}

# Fast fail-fast checks before a build/boot even starts. ROOT_DISK (a disk image)
# may legitimately be unset for build-only tests that never boot a VM; in
# that case bin/vng/cmd itself is the real enforcement point (it always
# requires a valid disk image, whenever it is actually invoked).
preflight_vng() {
	local root=${1-}
	local arch=${2-}
	local busybox

	root=$(normalize_root "$root")
	if [[ -n $root ]]; then
		[[ -f $root ]] || die "ROOT_DISK is not a regular file (expected a disk image): $root"
	fi

	arch=$(normalize_arch "$arch")
	busybox=$(busybox_path "$arch")
	[[ -x $busybox ]] || die "missing static busybox: $busybox (run $THIS_DIR/bin/setup/build-busybox $arch)"
}

usage() {
	cat <<'EOF'
usage: cross <command> [args]

commands:
  build-target <arch>
  busybox-path <arch>
  cross-compile <arch>
  disk-arch <path>
  is-foreign <arch>
  normalize-arch <arch>
  preflight-root <root> [arch]
  preflight-vng [root] [arch]
  resolve-arch [root] [arch]
  root-arch <root>
  suse-arch <arch>
  vng-arch <arch>
EOF
}

cmd=${1-}
shift || true

case "$cmd" in
build-target)
	[[ $# -eq 1 ]] || die "usage: cross build-target <arch>"
	build_target "$1"
	;;
busybox-path)
	[[ $# -eq 1 ]] || die "usage: cross busybox-path <arch>"
	busybox_path "$1"
	;;
cross-compile)
	[[ $# -eq 1 ]] || die "usage: cross cross-compile <arch>"
	cross_compile "$1"
	;;
disk-arch)
	[[ $# -eq 1 ]] || die "usage: cross disk-arch <path>"
	disk_arch "$1"
	;;
is-foreign)
	[[ $# -eq 1 ]] || die "usage: cross is-foreign <arch>"
	is_foreign "$1"
	;;
normalize-arch)
	[[ $# -eq 1 ]] || die "usage: cross normalize-arch <arch>"
	normalize_arch "$1"
	;;
preflight-root)
	[[ $# -ge 1 && $# -le 2 ]] || die "usage: cross preflight-root <root> [arch]"
	preflight_root "${1-}" "${2-}"
	;;
preflight-vng)
	[[ $# -ge 0 && $# -le 2 ]] || die "usage: cross preflight-vng [root] [arch]"
	preflight_vng "${1-}" "${2-}"
	;;
resolve-arch)
	[[ $# -ge 0 && $# -le 2 ]] || die "usage: cross resolve-arch [root] [arch]"
	resolve_arch "${1-}" "${2-}"
	;;
root-arch)
	[[ $# -eq 1 ]] || die "usage: cross root-arch <root>"
	root_arch "$1"
	;;
suse-arch)
	[[ $# -eq 1 ]] || die "usage: cross suse-arch <arch>"
	suse_arch "$1"
	;;
vng-arch)
	[[ $# -eq 1 ]] || die "usage: cross vng-arch <arch>"
	vng_arch "$1"
	;;
"" | -h | --help | help)
	usage
	;;
*)
	die "unknown command: $cmd"
	;;
esac
