#!/bin/bash -eu

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")
PROJECT_DIR=$(realpath -- "$THIS_DIR/..")
export BIN=$THIS_DIR
export HOOKS=${HOOKS:-$PROJECT_DIR/hooks}

while [[ $# -gt 0 ]]; do
	case "$1" in
	--)
		shift
		break
		;;
	*=*)
		key=${1%%=*}
		val=${1#*=}
		if [[ $key == ROOT && -n $val ]]; then
			# avoids mount/umount issues if $ROOT is a symlink
			if root_real=$(realpath -- "$val" 2>/dev/null); then
				val=$root_real
			fi
		fi
		if [[ -n $val ]]; then
			export "$key=$val"
		fi
		shift
		;;
	*)
		echo "ERROR: invalid setenv argument '$1'" >&2
		exit 1
		;;
	esac
done

if [[ $# -eq 0 ]]; then
	echo "ERROR: missing command after --" >&2
	exit 1
fi

exec "$@"
