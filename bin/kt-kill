#!/usr/bin/env bash
set -e

state=${1:?usage: kt-kill <workspace>}
# Every process of the run (runner, ktest, VM) holds the workspace lock on
# fd 9; signal them all so ktest stops even if the runner is already gone.
pids=()
for fd in /proc/[0-9]*/fd/9; do
	[[ $fd -ef $state/lock ]] && { p=${fd#/proc/}; pids+=("${p%%/*}"); }
done
((${#pids[@]})) || {
	echo "no active ktest run: $state" >&2
	exit 1
}
kill -TERM -- "${pids[@]}" 2>/dev/null || true
