#!/usr/bin/env bash
# Run a build in CHROOT, or on the host if CHROOT is empty. The caller
# maps to root inside a user namespace, so no sudo or chown is needed.
# The base rootfs is the read-only lower layer. Mounts last for one
# invocation; the user-owned upper layer persists under TMP_DIR/chroot.
#
# Bind targets are created in the upper layer, but the actual source and
# output stay at their host paths: /home/linux is still /home/linux inside.
# /tmp is separate scratch space in the upper layer, used as HOME and TMPDIR.
set -e

if [[ ${1-} != --mounted ]]; then
	# An empty CHROOT runs the command on the host.
	[[ -n ${CHROOT-} ]] || exec "$@"
	CHROOT=$(realpath -e -- "$CHROOT")
	TMP_DIR=$(realpath -m -- "${TMP_DIR:?TMP_DIR is required}")
	# One overlay per rootfs: an upper layer must not change its lower layer.
	OVERLAY=$TMP_DIR/chroot$CHROOT
	export CHROOT OVERLAY
	mkdir -p "$OVERLAY"/{upper,work,merged}
	exec unshare --user --map-root-user --mount --pid --fork --kill-child --forward-signals -- \
		"$0" --mounted "$@"
fi
shift

upper=$OVERLAY/upper
root=$OVERLAY/merged
read -r -a extra_binds <<< "${CHROOT_BINDS-}"
binds=("$BUILD_DIR" "$OUTPUT_DIR" "${extra_binds[@]}")

# Seed mount targets and /tmp before mounting: namespace root cannot write
# into system-owned lower directories.
mkdir -p -- "$upper"/{proc,dev,sys,tmp}
for dir in "${binds[@]}"; do
	mkdir -p -- "$upper$dir"
done

mount -t overlay overlay \
	-o "lowerdir=$CHROOT,upperdir=$upper,workdir=$OVERLAY/work" "$root"
mount -t proc proc "$root/proc"
mount --rbind /dev "$root/dev"
mount --rbind /sys "$root/sys"
for dir in "${binds[@]}"; do
	mount --rbind "$dir" "$root$dir"
done

trap 'exit 130' INT
trap 'exit 143' TERM
chroot "$root" /usr/bin/env -i \
	PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
	HOME=/tmp TMPDIR=/tmp USER=root LOGNAME=root \
	LANG="${LANG:-C}" TERM="${TERM:-dumb}" "$@" <&0 &
wait "$!"
