#!/bin/bash -eu

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/../env.sh"

[[ -n ${CHROOT-} ]] || exit 0
resolve_chroot || exit 1
chroot_overlay_paths || exit 1
chroot_ns_paths || exit 1

# No namespace holder running means nothing is mounted and nothing to tear
# down (see chroot_ns_alive in bin/env.sh).
chroot_ns_alive || exit 0

# Best-effort: clear any leftover mounts under the merged view first (proc,
# resolv.conf, OUTPUT_DIR, BUILD_DIR). This is expected to always report
# /dev and /sys (and their recursive sub-mounts) as still there -- the
# kernel unconditionally protects any mount recursively rbind-propagated
# into this namespace from a different (host) user namespace against being
# individually unmounted from inside it (see bin/chroot/umount's own
# comment for the confirmed mechanism/kernel source reference) -- so that
# expected outcome is silenced here; kill_chroot_ns below removes them
# unconditionally moments later regardless. Run bin/chroot/umount directly
# (not silenced) instead of this script if that detail actually matters for
# some debugging purpose.
"$BIN"/chroot/umount >/dev/null 2>&1 || true

# The overlay mount itself is not subject to the same cross-userns lock (it
# is created fresh inside this namespace, not propagated in from outside
# it), so a genuine, transient EBUSY here is plausible and worth retrying;
# same retry + lazy-unmount-as-last-resort as bin/chroot/umount, done inside
# the namespace holder via chroot_nsenter (see bin/env.sh).
for ((attempt = 0; attempt < 5; attempt++)); do
	chroot_nsenter umount "$CHROOT_MERGED" 2>/dev/null && break
	chroot_nsenter grep -q " $CHROOT_MERGED " /proc/mounts 2>/dev/null || break
	sleep 0.2
done
if chroot_nsenter grep -q " $CHROOT_MERGED " /proc/mounts 2>/dev/null; then
	echo "WARN: $CHROOT_MERGED still busy after retries, forcing a lazy unmount" >&2
	chroot_nsenter umount -l "$CHROOT_MERGED" 2>/dev/null || true
fi

# Actually complete the teardown: kill the namespace holder itself. Unlike
# the old real-root design, unmounting is no longer enough on its own -- the
# private user+mount+pid namespace must also be torn down, which now
# happens automatically and atomically the moment the process holding it
# open dies (see kill_chroot_ns in bin/env.sh), regardless of whether the
# umount loop above fully succeeded on its own.
kill_chroot_ns
