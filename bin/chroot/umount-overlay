#!/bin/bash -eu

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/../env.sh"

[[ -n ${CHROOT-} ]] || exit 0
resolve_chroot || exit 1
chroot_overlay_paths || exit 1
chroot_ns_paths || exit 1

# No namespace holder running means nothing is mounted and nothing to tear
# down (see chroot_ns_alive in bin/env.sh).
chroot_ns_alive || exit 0

# Best-effort: clear leftover mounts under the merged view first (proc,
# resolv.conf, OUTPUT_DIR, BUILD_DIR). /dev and /sys are expected to still
# be reported (kernel-locked against individual unmount, see
# bin/chroot/umount) -- silenced here since kill_chroot_ns below removes
# them unconditionally regardless; run bin/chroot/umount directly instead
# if that detail matters for debugging.
"$BIN"/chroot/umount >/dev/null 2>&1 || true

# The overlay mount is not subject to the same cross-userns lock (created
# fresh in this namespace, not propagated in), so a genuine transient EBUSY
# is worth retrying; same retry + lazy-unmount fallback as bin/chroot/umount.
for ((attempt = 0; attempt < 5; attempt++)); do
	chroot_nsenter umount "$CHROOT_MERGED" 2>/dev/null && break
	chroot_nsenter grep -q " $CHROOT_MERGED " /proc/mounts 2>/dev/null || break
	sleep 0.2
done
if chroot_nsenter grep -q " $CHROOT_MERGED " /proc/mounts 2>/dev/null; then
	echo "WARN: $CHROOT_MERGED still busy after retries, forcing a lazy unmount" >&2
	chroot_nsenter umount -l "$CHROOT_MERGED" 2>/dev/null || true
fi

# Complete the teardown: killing the namespace holder tears down the
# private user+mount+pid namespace atomically, regardless of whether the
# umount loop above fully succeeded on its own.
kill_chroot_ns
