#!/usr/bin/env bash

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/../env.sh"

[[ -n ${CHROOT-} ]] || exit 0
resolve_chroot || exit 1
chroot_overlay_paths || exit 1
chroot_ns_paths || exit 1

# No namespace holder running means nothing is mounted (every mount
# bin/chroot/* makes lives inside the holder's mount namespace, which
# cannot outlive it) and nothing to do.
chroot_ns_alive || exit 0

# unmount mountpoints under this run's merged chroot, deepest first (a
# descending sort always visits a child before its own parent). Never
# touches CHROOT_MERGED itself (the overlay), only what was bind-mounted
# into it (proc, dev, sys, resolv.conf, OUTPUT_DIR, BUILD_DIR); the overlay
# is torn down separately by bin/chroot/umount-overlay. Read via
# chroot_nsenter since these mounts live in the holder's own private mount
# table, invisible to a plain host-side /proc/mounts read.
#
# A mount left behind here is not just messy: OUTPUT_DIR/BUILD_DIR are
# bind-mounted from real host paths, so a later "rm -rf" of TMP_DIR would
# recurse through the bind and delete the real source tree. So a transient
# EBUSY is retried a few times, then falls back to a lazy unmount.
#
# IMPORTANT: every mount rbind-propagated into this namespace from a
# *different* (host) user namespace -- i.e. every /dev/* and /sys/* entry
# from bin/chroot/mount's `mount --rbind` -- is unconditionally kernel-
# locked against being individually unmounted from inside this namespace,
# lazily or not (MNT_LOCKED; same restriction rootless container runtimes
# hit). This is a hard kernel policy, not a race: the retries/WARN below
# are expected to fail for exactly those entries every time this script
# runs standalone. Only destroying the whole mount namespace (kill_chroot_ns
# via bin/chroot/umount-overlay) actually removes them, which is why
# bin/chroot/mount's cleanup trap calls that instead of just this script.
unmount_one() {
	local m=$1
	local attempt

	for ((attempt = 0; attempt < 3; attempt++)); do
		if chroot_nsenter umount "$m" 2>/dev/null; then
			return 0
		fi
		# ignore races where the target is already gone.
		chroot_nsenter grep -q " $m " /proc/mounts 2>/dev/null || return 0
		sleep 0.2
	done

	if chroot_nsenter umount -l "$m" 2>/dev/null; then
		return 0
	fi
	# Expected/benign for a locked /dev or /sys entry (see above) -- call
	# bin/chroot/umount-overlay for a full teardown if that is what is
	# actually needed; only warn here since this is likely one of those.
	echo "WARN: $m still mounted (locked mounts like /dev, /sys can only be cleared by a full teardown -- see bin/chroot/umount-overlay)" >&2
	! chroot_nsenter grep -q " $m " /proc/mounts 2>/dev/null
}

ret=0
while read -r m; do
	unmount_one "$m" || ret=1
done < <(
	chroot_nsenter grep " $CHROOT_MERGED/" /proc/mounts | awk '{print $2}' | sort -r
)
exit $ret
