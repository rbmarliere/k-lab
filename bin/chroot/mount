#!/bin/bash -eu

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/../env.sh"

cleanup_needed=
cleanup() {
	local rc=$?

	if [[ -n $cleanup_needed ]]; then
		"$BIN"/chroot/umount >/dev/null 2>&1 || true
	fi

	exit $rc
}
trap cleanup EXIT

resolve_chroot || exit 1
chroot_overlay_paths || exit 1

# Every build gets its own private overlay over CHROOT (see
# chroot_overlay_paths in bin/env.sh); everything below mounts into that
# per-run merged view, not into CHROOT itself, so concurrent builds against
# the same CHROOT never collide.
"$BIN"/chroot/mount-overlay

ensure_resolv_conf_target() {
	local target=$CHROOT_MERGED/etc/resolv.conf

	if [[ -e $target ]]; then
		return 0
	fi

	"$BIN"/run --as-root touch "$target" || {
		echo "ERROR: unable to create $target" >&2
		exit 1
	}
}

# Idempotent: if this run's full mount (proc plus the rest below) is already
# in place, there is nothing to do.
if grep -q " $CHROOT_MERGED/proc " /proc/mounts; then
	exit 0
fi

# Refuse to proceed if this run's merged chroot already has some (but not
# all, per the check above) mounts under it -- e.g. a stale mount left
# behind by a crashed earlier invocation reusing the same TMP_DIR.
mounted_under_chroot=$(
	grep " $CHROOT_MERGED/" /proc/mounts | awk '{print $2}' | sort -r || true
)
if [[ -n $mounted_under_chroot ]]; then
	echo "ERROR: refusing to mount on top of existing mounts under $CHROOT_MERGED" >&2
	echo "ERROR: $mounted_under_chroot" >&2
	exit 1
fi

ensure_resolv_conf_target

"$BIN"/run --as-root mount -t proc proc "$CHROOT_MERGED"/proc
cleanup_needed=1
"$BIN"/run --as-root mount --rbind /dev "$CHROOT_MERGED"/dev
"$BIN"/run --as-root mount --make-rslave "$CHROOT_MERGED"/dev
"$BIN"/run --as-root mount --rbind /sys "$CHROOT_MERGED"/sys
"$BIN"/run --as-root mount --make-rslave "$CHROOT_MERGED"/sys

"$BIN"/run --as-root mount --bind /etc/resolv.conf "$CHROOT_MERGED"/etc/resolv.conf
"$BIN"/run --as-root mount -o remount,bind,ro /etc/resolv.conf "$CHROOT_MERGED"/etc/resolv.conf

if [[ -n ${OUTPUT_DIR-} ]]; then
	"$BIN"/run --as-root mount --mkdir --bind "$OUTPUT_DIR" "$CHROOT_MERGED$OUTPUT_DIR"
fi

if [[ -n ${BUILD_DIR-} ]]; then
	"$BIN"/run --as-root mount --mkdir --bind "$BUILD_DIR" "$CHROOT_MERGED$BUILD_DIR"
fi

cleanup_needed=
