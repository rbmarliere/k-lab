#!/bin/bash -eu

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/../env.sh"

die() {
	echo "ERROR: $*" >&2
	exit 1
}

run_as_user=
while [[ $# -gt 0 ]]; do
	case "$1" in
	--as-user)
		run_as_user=1
		shift
		;;
	--)
		shift
		break
		;;
	*)
		break
		;;
	esac
done

[[ $# -gt 0 ]] || die "missing command"
resolve_chroot || exit 1
chroot_overlay_paths || exit 1
chroot_ns_paths || exit 1

# Make sure this run's private overlay+mounts over CHROOT exist (idempotent)
# so standalone callers do not need to mount first. Also guarantees the
# namespace holder chroot_nsenter joins below is running.
"$BIN"/chroot/mount

chroot_args=()
# A plain PATH (no host toolchain dirs) so the target's own native binaries
# (its own gcc, make, sh, ...) resolve inside the chroot, transparently
# emulated for foreign arches by the host's qemu-user/binfmt_misc
# registration (which pins its interpreter fd at registration time, so it
# works regardless of what is or is not present inside the chroot).
env_args=(
	PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
	TMPDIR=/tmp
)

if [[ -n $run_as_user ]]; then
	user=$(id -un 2>/dev/null || echo user)

	# No --userspec here, unlike the old real-root chroot: coreutils'
	# chroot unconditionally calls setgroups() whenever --userspec is
	# given, which fails under the single-range --map-root-user mapping
	# the namespace holder uses (fixing that needs newuidmap/newgidmap
	# setuid-root plus subuid/subgid delegation -- "Option A" in
	# plans/03-chroot-build-userns.md, not set up here). Deliberate,
	# documented behavior change ("Option B"): ns-uid 0 is never real
	# root, so anything it does can only touch files the invoking uid
	# could already touch. The only practical difference is id(1)/
	# getuid() now reporting 0 under --as-user too, so a build that
	# branches on `[ "$(id -u)" = 0 ]` may now take that branch.
	env_args+=(
		SHELL=/bin/sh
		HOME=/tmp
		USER="$user"
		LOGNAME="$user"
	)
else
	env_args+=(
		SHELL=/bin/sh
		HOME=/root
		USER=root
		LOGNAME=root
	)
fi

if [[ -n ${TERM-} ]]; then
	env_args+=(
		TERM="$TERM"
	)
fi
if [[ -n ${LANG-} ]]; then
	env_args+=(LANG="$LANG")
else
	env_args+=(LANG=C)
fi
if [[ -n ${LC_ALL-} ]]; then
	env_args+=(LC_ALL="$LC_ALL")
fi

# Keep the environment explicit and run via a real chroot(2), joined to
# this run's namespace holder instead of real host root. Chroots into this
# run's private merged view of CHROOT, never CHROOT itself. chroot_args is
# currently always empty (see "Option B" above); kept as the place a
# future "Option A" (--userspec=...) would populate it again.
#
# Not `exec`: chroot_nsenter is a shell function, not an executable, but
# nsenter still execs "$@" as this script's last action either way, so the
# exit status is the same as `exec` would give.
chroot_nsenter chroot "${chroot_args[@]}" "$CHROOT_MERGED" /usr/bin/env -i "${env_args[@]}" "$@"
