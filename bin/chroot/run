#!/bin/bash -eu

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/../env.sh"

die() {
	echo "ERROR: $*" >&2
	exit 1
}

run_as_user=
while [[ $# -gt 0 ]]; do
	case "$1" in
	--as-user)
		run_as_user=1
		shift
		;;
	--)
		shift
		break
		;;
	*)
		break
		;;
	esac
done

[[ $# -gt 0 ]] || die "missing command"
resolve_chroot || exit 1
chroot_overlay_paths || exit 1

# Make sure this run's private overlay+mounts over CHROOT exist (idempotent)
# so standalone callers do not need to mount first.
"$BIN"/chroot/mount

chroot_args=()
# A plain PATH (no host toolchain dirs) so the target's own native binaries
# (its own gcc, make, sh, ...) resolve inside the chroot, transparently
# emulated for foreign arches by the host's qemu-user/binfmt_misc
# registration (which pins its interpreter fd at registration time, so it
# works regardless of what is or is not present inside the chroot).
env_args=(
	PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
	TMPDIR=/tmp
)

if [[ -n $run_as_user ]]; then
	uid=$(id -u)
	gid=$(id -g)
	user=$(id -un 2>/dev/null || echo user)

	chroot_args+=(--userspec="$uid:$gid")
	env_args+=(
		SHELL=/bin/sh
		HOME=/tmp
		USER="$user"
		LOGNAME="$user"
	)
else
	env_args+=(
		SHELL=/bin/sh
		HOME=/root
		USER=root
		LOGNAME=root
	)
fi

if [[ -n ${TERM-} ]]; then
	env_args+=(
		TERM="$TERM"
	)
fi
if [[ -n ${LANG-} ]]; then
	env_args+=(LANG="$LANG")
else
	env_args+=(LANG=C)
fi
if [[ -n ${LC_ALL-} ]]; then
	env_args+=(LC_ALL="$LC_ALL")
fi

# Keep the environment explicit and run the command via a real host-root
# chroot. Chroot into this run's private merged view of CHROOT, never
# CHROOT itself. Route through bin/run (like every other privileged call in
# bin/chroot/*) instead of invoking sudo directly, so the sudoers-failure
# detection/error message in bin/run also covers this call; bin/run already
# skips sudo when we are already root.
exec "$BIN"/run --as-root -- \
	chroot "${chroot_args[@]}" "$CHROOT_MERGED" /usr/bin/env -i "${env_args[@]}" "$@"
