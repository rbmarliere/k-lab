#!/usr/bin/env bash

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/../env.sh"

build_options=${BUILD_OPTIONS-}
for arg in "$@"; do
	case "$arg" in
	clean | mrproper | distclean)
		build_options=
		break
		;;
	esac
done

cmd=(make)
if [[ -n $build_options ]]; then
	cmd+=("$build_options")
fi
cmd+=(-C "$BUILD_DIR" O="$OUTPUT_DIR")
if [[ -n ${ARCH-} ]]; then
	cmd+=("ARCH=$ARCH")
fi
# No CROSS_COMPILE: CHROOT's own native toolchain is used directly (the
# chroot IS that architecture, transparently emulated via qemu-user when
# foreign to the host). CC/HOSTCC/HOSTCFLAGS still forward through if a test
# explicitly set them (e.g. to pick an alternate compiler present in CHROOT).
if [[ -n ${CC-} ]]; then
	cmd+=("CC=$CC")
fi
if [[ -n ${HOSTCC-} ]]; then
	cmd+=("HOSTCC=$HOSTCC")
fi
if [[ -n ${HOSTCFLAGS-} ]]; then
	cmd+=("HOSTCFLAGS=$HOSTCFLAGS")
fi

cmd+=("$@")

exec "$BIN"/chroot/run --as-user "${cmd[@]}"
