#!/bin/bash -eu

die() {
	echo "ERROR: $*" >&2
	exit 1
}

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/../env.sh"

resolve_root || exit 1
rootfs_overlay_paths || exit 1

mounted=
cleanup() {
	local rc=$?

	if [[ -n $mounted ]]; then
		if ! "$BIN"/rootfs/umount; then
			echo "ERROR: failed to unmount rootfs at ROOT=$ROOT" >&2
			if [[ $rc -eq 0 ]]; then
				rc=1
			fi
		fi
		if ! "$BIN"/rootfs/umount-overlay; then
			echo "ERROR: failed to unmount rootfs overlay at ROOT=$ROOT" >&2
			if [[ $rc -eq 0 ]]; then
				rc=1
			fi
		fi
	fi

	exit $rc
}
trap cleanup EXIT

if [[ -x $ROOT/bin/bash ]]; then
	root_shell=/bin/bash
else
	root_shell=/bin/sh
fi

if [[ ! -x $ROOT${root_shell} ]]; then
	die "no usable shell found in ROOT=$ROOT"
fi

"$BIN"/rootfs/mount
mounted=1

if [[ $# -eq 0 ]]; then
	if [[ $root_shell == /bin/bash ]]; then
		"$BIN"/rootfs/run "$root_shell" -il
		exit $?
	fi

	"$BIN"/rootfs/run "$root_shell" -i
	exit $?
fi

case "$1" in
--)
	shift
	[[ $# -gt 0 ]] || die "missing command after --"
	"$BIN"/rootfs/run "$@"
	;;
-*)
	"$BIN"/rootfs/run "$root_shell" "$@"
	;;
*)
	"$BIN"/rootfs/run "$@"
	;;
esac
