#!/bin/bash -eu

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/../../env.sh"

die() {
	echo "ERROR: $*" >&2
	exit 1
}

[[ $# -gt 0 ]] || die "missing command"
resolve_root || exit 1

env_args=(
	PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
	SHELL=/bin/sh
	TMPDIR=/tmp
	HOME=/root
	USER=root
	LOGNAME=root
)
if [[ -n ${TERM-} ]]; then
	env_args+=(
		TERM="$TERM"
	)
fi
if [[ -n ${LANG-} ]]; then
	env_args+=(LANG="$LANG")
else
	env_args+=(LANG=C)
fi
if [[ -n ${LC_ALL-} ]]; then
	env_args+=(LC_ALL="$LC_ALL")
fi

# Keep the environment explicit and run the command via a real host-root
# chroot so package managers see normal rootfs ownership semantics.
if [[ $(id -u) -eq 0 ]]; then
	exec chroot "$ROOT" /usr/bin/env -i "${env_args[@]}" "$@"
fi

exec sudo -n -- chroot "$ROOT" /usr/bin/env -i "${env_args[@]}" "$@"
