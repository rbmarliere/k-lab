#!/bin/bash -eu

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/../env.sh"

resolve_root || exit 1
rootfs_overlay_paths || exit 1

if [[ ! -d $ROOT ]]; then
	echo "ERROR: $ROOT directory does not exist, exiting..." >&2
	exit 1
fi

# Idempotent: a run may call this many times (mount, run, vng boot/reboot),
# but the overlay only needs to be mounted once per TMP_DIR.
if grep -q " $ROOT_MERGED " /proc/mounts; then
	exit 0
fi

mkdir -p "$ROOTFS_UPPER" "$ROOTFS_WORK" "$ROOT_MERGED"

"$BIN"/run --as-root mount -t overlay overlay \
	-o "lowerdir=$ROOT,upperdir=$ROOTFS_UPPER,workdir=$ROOTFS_WORK" \
	"$ROOT_MERGED"
