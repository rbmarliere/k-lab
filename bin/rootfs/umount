#!/bin/bash -eu

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/../env.sh"

[[ -n ${ROOT-} ]] || exit 0
resolve_root || exit 1
rootfs_overlay_paths || exit 1

# unmount mountpoints under this run's merged rootfs, deepest first. This
# never touches ROOT_MERGED itself (the overlay), only what was bind-mounted
# into it (proc, dev, sys, resolv.conf, OUTPUT_DIR, BUILD_DIR); the overlay
# is torn down separately by bin/rootfs/umount-overlay.
ret=0
while read -r m; do
	if "$BIN"/run --as-root umount "$m"; then
		continue
	fi

	# ignore races where the target is already gone (e.g. "not mounted").
	if ! grep -q " $m " /proc/mounts 2>/dev/null; then
		continue
	fi

	ret=1
done < <(
	grep " $ROOT_MERGED/" /proc/mounts | awk '{print $2}' | sort -r
)
exit $ret
