#!/bin/bash -eu

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/env.sh"

if [[ -n ${TMP_DIR-} ]] && [[ -r $TMP_DIR/env.sh ]]; then
	# shellcheck disable=SC1090
	source "$TMP_DIR/env.sh"
fi

# Plain env-establishing wrapper: re-sources the k-lab environment (above)
# before running "$@", which is what every ktest.pl-invoked hook and
# command needs, since ktest.pl otherwise runs them with only its own
# SETENV environment. No privilege escalation happens here (or anywhere
# else in this repo) any more -- this used to also support a `--as-root`
# mode that ran "$@" under `sudo`, needed by bin/chroot/*; that was its
# last caller, and it now runs unprivileged builds inside an unprivileged
# user namespace instead (see ensure_chroot_ns/chroot_nsenter in
# bin/env.sh, and plans/03-chroot-build-userns.md), so `--as-root` was
# removed entirely rather than left as unreachable dead code.
if [[ $# -eq 0 ]]; then
	echo "ERROR: missing command" >&2
	exit 1
fi

exec "$@"
