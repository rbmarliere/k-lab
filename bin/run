#!/bin/bash -eu

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/env.sh"

if [[ -n ${TMP_DIR-} ]] && [[ -r $TMP_DIR/env.sh ]]; then
	# shellcheck disable=SC1090
	source "$TMP_DIR/env.sh"
fi

is_sudo_failure() {
	local stderr_file=$1

	grep -Eq '^(sudo:|Sorry, user )' "$stderr_file"
}

run_as_root=
while [[ $# -gt 0 ]]; do
	case "$1" in
	--as-root)
		run_as_root=1
		shift
		;;
	--)
		shift
		break
		;;
	*)
		break
		;;
	esac
done

if [[ $# -eq 0 ]]; then
	echo "ERROR: missing command" >&2
	exit 1
fi

if [[ -n $run_as_root ]]; then
	if [[ $(id -u) -eq 0 ]]; then
		exec "$@"
	fi

	stderr_file=$(mktemp)
	rc=0
	sudo -n -- "$@" 2> >(tee "$stderr_file" >&2) || rc=$?
	if [[ $rc -ne 0 ]]; then
		if is_sudo_failure "$stderr_file"; then
			echo "ERROR: privileged host command failed: $1" >&2
			echo "ERROR: check passwordless sudo and sudoers for that binary" >&2
		fi
		rm -f -- "$stderr_file"
		exit $rc
	fi
	rm -f -- "$stderr_file"
	exit 0
else
	exec "$@"
fi
