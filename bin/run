#!/bin/bash -eu

run_as_root=
run_on_host=
while [[ $# -gt 0 ]]; do
	case "$1" in
	--as-root)
		run_as_root=1
		shift
		;;
	--host)
		run_on_host=1
		shift
		;;
	--)
		shift
		break
		;;
	*)
		break
		;;
	esac
done

if [[ $# -eq 0 ]]; then
	echo "ERROR: missing command" >&2
	exit 1
fi

if [[ -n ${ROOT-} && -z $run_on_host ]]; then
	exec "$BIN"/rootfs/run "$@"
fi

if [[ -n $run_as_root ]]; then
	if [[ $(id -u) -eq 0 ]]; then
		exec "$@"
	fi

	rc=0
	sudo -n -- "$@" || rc=$?
	if [[ $rc -ne 0 ]]; then
		echo "ERROR: privileged host command failed: $1" >&2
		echo "ERROR: check passwordless sudo and sudoers for that binary" >&2
		exit $rc
	fi
	exit 0
else
	exec "$@"
fi
