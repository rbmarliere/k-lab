#!/bin/bash -eu

THIS_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1091
source "$THIS_DIR/env.sh"

if [[ -n ${TMP_DIR-} ]] && [[ -r $TMP_DIR/env.sh ]]; then
	# shellcheck disable=SC1090
	source "$TMP_DIR/env.sh"
fi

# Plain env-establishing wrapper: re-sources the k-lab environment (above)
# before running "$@", which every ktest.pl-invoked hook/command needs
# (ktest.pl otherwise runs them with only its own SETENV environment).
if [[ $# -eq 0 ]]; then
	echo "ERROR: missing command" >&2
	exit 1
fi

exec "$@"
