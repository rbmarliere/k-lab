#!/bin/bash -eu

# CHROOT_BUILD=1 builds inside CHROOT (a directory produced by e.g.
# bin/setup/debootstrap or bin/setup/suse-bootstrap) using ITS OWN native
# toolchain, via a real chroot; foreign arches are transparently emulated by
# the host's qemu-user/binfmt_misc registration. See bin/chroot/*.
if [[ ${CHROOT_BUILD:-0} == 1 ]]; then
	[[ -n ${CHROOT-} && -d $CHROOT ]] || {
		echo "ERROR: CHROOT_BUILD=1 requires CHROOT to be a directory: ${CHROOT-}" >&2
		exit 1
	}
	exec "$BIN"/chroot/make "$@"
fi

build_options=${BUILD_OPTIONS-}
for arg in "$@"; do
	case "$arg" in
	clean | mrproper | distclean)
		build_options=
		break
		;;
	esac
done

make_cmd=(make)
if [[ -n $build_options ]]; then
	make_cmd+=("$build_options")
fi
make_cmd+=(-C "$BUILD_DIR" O="$OUTPUT_DIR")
if [[ -n ${ARCH-} ]]; then
	make_cmd+=("ARCH=$ARCH")
fi
if [[ -n ${CROSS_COMPILE-} ]]; then
	make_cmd+=("CROSS_COMPILE=$CROSS_COMPILE")
fi
if [[ -n ${CC-} ]]; then
	make_cmd+=("CC=$CC")
fi
if [[ -n ${HOSTCC-} ]]; then
	make_cmd+=("HOSTCC=$HOSTCC")
fi
if [[ -n ${HOSTCFLAGS-} ]]; then
	make_cmd+=("HOSTCFLAGS=$HOSTCFLAGS")
fi

exec "${make_cmd[@]}" "$@"
