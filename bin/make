#!/bin/bash -eu

build_options=${BUILD_OPTIONS-}
for arg in "$@"; do
	case "$arg" in
	clean | mrproper | distclean)
		build_options=
		break
		;;
	esac
done

make_cmd=(make)
if [[ -n $build_options ]]; then
	make_cmd+=("$build_options")
fi
make_cmd+=(-C "$BUILD_DIR" O="$OUTPUT_DIR")
if [[ -n ${ARCH-} ]]; then
	make_cmd+=("ARCH=$ARCH")
fi
if [[ -n ${CROSS_COMPILE-} ]]; then
	make_cmd+=("CROSS_COMPILE=$CROSS_COMPILE")
fi
if [[ -n ${CC-} ]]; then
	make_cmd+=("CC=$CC")
fi
if [[ -n ${HOSTCC-} ]]; then
	make_cmd+=("HOSTCC=$HOSTCC")
fi
if [[ -n ${HOSTCFLAGS-} ]]; then
	make_cmd+=("HOSTCFLAGS=$HOSTCFLAGS")
fi

if [[ ${BUILD_IN_ROOT:-0} == 1 ]] && [[ -n ${ROOT-} ]]; then
	exec "$BIN"/rootfs/make "$@"
fi

exec "${make_cmd[@]}" "$@"
