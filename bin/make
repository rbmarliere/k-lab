#!/usr/bin/env bash

make_cmd=(make)
make_cmd+=(-C "$BUILD_DIR" O="$OUTPUT_DIR")
if [[ -n ${ARCH-} ]]; then
	make_cmd+=("ARCH=$ARCH")
fi
if [[ -z ${CHROOT-} && -n ${CROSS_COMPILE-} ]]; then
	make_cmd+=("CROSS_COMPILE=$CROSS_COMPILE")
fi
if [[ -n ${CC-} ]]; then
	make_cmd+=("CC=$CC")
fi
if [[ -n ${HOSTCC-} ]]; then
	make_cmd+=("HOSTCC=$HOSTCC")
fi
if [[ -n ${HOSTCFLAGS-} ]]; then
	make_cmd+=("HOSTCFLAGS=$HOSTCFLAGS")
fi

# Empty environment overrides suppress makefile defaults. Nonempty settings
# are already in make_cmd; CROSS_COMPILE is deliberately omitted in chroots.
unset CC HOSTCC HOSTCFLAGS CROSS_COMPILE

if [[ -n ${CHROOT-} ]]; then
	exec "$BIN"/chroot "${make_cmd[@]}" "$@"
fi
exec "${make_cmd[@]}" "$@"
