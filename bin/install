#!/bin/bash -eu

auto_install=
declare -A fallback_map_files=()
declare -a pkg_files=()
lookup_package_result=
while [[ $# -gt 0 ]]; do
	case "$1" in
	--auto)
		auto_install=1
		shift
		;;
	--)
		shift
		break
		;;
	*)
		break
		;;
	esac
done

if [[ $# -eq 0 ]]; then
	exit 0
fi

die() {
	echo "ERROR: $*" >&2
	exit 1
}

use_root_install() {
	[[ -n ${ROOT-} ]] || return 1
	if [[ ${BUILD_IN_ROOT:-0} == 1 ]]; then
		return 0
	fi

	! "$BIN"/cross is-foreign "${ARCH:-x86_64}"
}

lookup_package() {
	local dep=$1
	local map_file pkg
	local map_names=()

	for map_file in "${pkg_files[@]}"; do
		map_names+=("$(basename "$map_file")")
		if [[ -e $map_file ]] && pkg=$(
			awk -v key="$dep" '
			$0 ~ /^[[:space:]]*#/ || NF == 0 { next }
			$1 == key {
				found = 1
				if (NF >= 2) {
					print $2
				}
				exit
			}
			END {
				if (!found) {
					exit 1
				}
			}
		' "$map_file"
		); then
			lookup_package_result=$pkg
			return 0
		fi
	done

	fallback_map_files[$dep]="${map_names[*]}"
	lookup_package_result=$dep
}

warn_fallback_packages() {
	local pkg

	for pkg in "$@"; do
		[[ -n ${fallback_map_files[$pkg]+x} ]] || continue
		echo "WARN: dependency '$pkg' is not mapped in ${fallback_map_files[$pkg]}; using '$pkg' as the package name" >&2
	done
}

run() {
	local mode=$1
	shift

	if use_root_install; then
		if [[ $mode != check ]] && [[ ${ID-} == debian ]]; then
			DEBIAN_FRONTEND=noninteractive "$BIN"/rootfs/run "$@"
		else
			"$BIN"/rootfs/run "$@"
		fi
		return
	fi

	if [[ $mode == check ]]; then
		"$@"
	else
		"$BIN"/run --as-root "$@"
	fi
}

ID=
ID_LIKE=
VERSION_ID=
etc_dir=/etc
if use_root_install; then
	etc_dir=$ROOT/etc
fi

if [[ -r $etc_dir/os-release ]]; then
	# shellcheck disable=SC1090
	. "$etc_dir/os-release"
elif [[ -r $etc_dir/debian_version ]]; then
	ID=debian
	VERSION_ID=$(<"$etc_dir/debian_version")
elif [[ -r $etc_dir/SuSE-release ]]; then
	ID=sles
else
	die "unable to detect distro under $etc_dir"
fi

case "$ID" in
debian | opensuse-tumbleweed | sles)
	;;
*)
	case " ${ID_LIKE-} " in
	*" suse "*)
		ID=sles
		;;
	esac
	;;
esac

case "$ID" in
debian)
	pkg_files=("$BIN"/../pkg/debian)
	check_cmd=(dpkg -s)
	repair_cmd=(dpkg --configure -a)
	update_cmd=(apt-get update)
	install_cmd=(apt-get install -y --allow-unauthenticated --force-yes)
	;;
opensuse-tumbleweed)
	pkg_files=("$BIN"/../pkg/tumbleweed)
	check_cmd=(rpm -q --whatprovides)
	repair_cmd=()
	update_cmd=(zypper --gpg-auto-import-keys refresh)
	install_cmd=(zypper --non-interactive install)
	;;
sles)
	case "${VERSION_ID:-}" in
	12*)
		pkg_files=("$BIN"/../pkg/sles12 "$BIN"/../pkg/sles "$BIN"/../pkg/tumbleweed)
		;;
	*)
		pkg_files=("$BIN"/../pkg/sles "$BIN"/../pkg/tumbleweed)
		;;
	esac
	check_cmd=(rpm -q --whatprovides)
	repair_cmd=()
	update_cmd=(zypper --gpg-auto-import-keys refresh)
	install_cmd=(zypper --non-interactive install)
	;;
*)
	die "unsupported distro ID=$ID"
	;;
esac

for pkg_file in "${pkg_files[@]}"; do
	if [[ ! -e $pkg_file ]]; then
		echo "WARN: File not found: $pkg_file" >&2
	fi
done

packages=()
for dep in "$@"; do
	lookup_package "$dep"
	[[ -n $lookup_package_result ]] && packages+=("$lookup_package_result")
done

mapfile -t packages < <(printf '%s\n' "${packages[@]}" | sort -u)

warn_fallback_packages "${packages[@]}"

missing=()
for pkg in "${packages[@]}"; do
	if ! run check "${check_cmd[@]}" "$pkg" >/dev/null 2>&1; then
		missing+=("$pkg")
	fi
done

if [[ ${#missing[@]} -gt 0 ]]; then
	if [[ -z $auto_install ]]; then
		echo "ERROR: missing dependency packages: ${missing[*]}" >&2
		echo "ERROR: automatic dependency installation is disabled; set AUTO_INSTALL_DEPS=1 to install them automatically" >&2
		exit 1
	fi

	echo "Installing missing dependency packages: ${missing[*]}"
	if [[ ${#repair_cmd[@]} -gt 0 ]]; then
		run install "${repair_cmd[@]}" || true
	fi
	run install "${update_cmd[@]}" || true
	run install "${install_cmd[@]}" "${missing[@]}"
else
	echo "All dependencies already installed!"
fi
