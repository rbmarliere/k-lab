#!/bin/bash -eu

# Generic kselftest installer: builds and installs the given TARGETS
# (tools/testing/selftests/Makefile collection names, e.g. "bpf" or
# "net net/forwarding" as a single argument) from a freshly built kernel tree.
# Runs with cwd = BUILD_DIR (ktest.pl chdir's there before POST_BUILD).
targets=${1:?usage: post-build <selftests TARGETS, e.g. "bpf" or "net net/forwarding">}

"$BIN"/make headers
git -C tools/testing/selftests clean -fdx
"$BIN"/make -C tools/testing/selftests SKIP_TARGETS= TARGETS="$targets" install
