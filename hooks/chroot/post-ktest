#!/usr/bin/env bash

[[ ${CHROOT_BUILD:-0} == 1 ]] || exit 0
[[ -n ${CHROOT-} ]] || exit 0

# Safety net: ktest.pl skips POST_BUILD_CHAIN when the build fails before
# reaching the actual build phase, so hooks/chroot/post-build's teardown
# never runs in that case. POST_KTEST still runs on any outcome, and
# bin/chroot/umount-overlay is idempotent (a no-op if post-build already
# cleaned up), so this is safe to always run here too. See
# hooks/chroot/post-build for why umount-overlay (not umount alone) is the
# authoritative full teardown, and why a real failure here is not swallowed.
if ! "$BIN"/chroot/umount-overlay; then
	echo "ERROR: failed to fully tear down CHROOT=$CHROOT (TMP_DIR=${TMP_DIR-}); refusing to leave stale mounts behind -- do not rm -rf TMP_DIR until this is resolved" >&2
	exit 1
fi
