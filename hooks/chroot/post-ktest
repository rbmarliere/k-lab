#!/bin/bash -eu

[[ ${CHROOT_BUILD:-0} == 1 ]] || exit 0
[[ -n ${CHROOT-} ]] || exit 0

# Safety net: ktest.pl skips POST_BUILD_CHAIN when the build fails before
# reaching the actual build phase (e.g. a failed oldconfig), so
# hooks/chroot/post-build's teardown never runs in that case. POST_KTEST
# still runs on any outcome, and bin/chroot/umount(-overlay) are idempotent
# (no-op if hooks/chroot/post-build already cleaned up), so this is safe to
# always run here too.
#
# Do NOT swallow a failed unmount here either (see hooks/chroot/post-build
# for why: OUTPUT_DIR/BUILD_DIR bind mounts left stale under TMP_DIR are
# dangerous, not just messy). This is the last chance to catch it, so make
# it loud even though nothing declares POST_KTEST_DIE.
ret=0
"$BIN"/chroot/umount || ret=1
"$BIN"/chroot/umount-overlay || ret=1

if [[ $ret -ne 0 ]]; then
	echo "ERROR: failed to fully unmount CHROOT=$CHROOT (TMP_DIR=${TMP_DIR-}); refusing to leave stale mounts behind -- do not rm -rf TMP_DIR until this is resolved" >&2
fi
exit $ret
