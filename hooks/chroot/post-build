#!/usr/bin/env bash

[[ ${CHROOT_BUILD:-0} == 1 ]] || exit 0
[[ -n ${CHROOT-} ]] || exit 0

# CHROOT is never booted (unlike ROOT_DISK), so nothing after the BUILD
# phase needs it mounted: tear it down right away.
#
# bin/chroot/umount-overlay alone is the authoritative full teardown: it
# calls bin/chroot/umount as a best-effort first step, then unmounts the
# overlay and kills the namespace holder, which is what actually clears
# every mount including /dev and /sys (those are kernel-locked against
# individual unmount from inside the namespace, so bin/chroot/umount alone
# can never fully succeed here -- see its own comment).
#
# Do NOT swallow a real failure, though: OUTPUT_DIR/BUILD_DIR are
# bind-mounted from real host paths, so a mount genuinely left behind is
# dangerous, not just messy -- a later "rm -rf" of TMP_DIR would recurse
# through the stale bind and delete the real source tree. Worth stopping
# the run over (POST_BUILD_DIE=1), not hiding behind a WARN.
if ! "$BIN"/chroot/umount-overlay; then
	echo "ERROR: failed to fully tear down CHROOT=$CHROOT (TMP_DIR=${TMP_DIR-}); refusing to leave stale mounts behind -- do not rm -rf TMP_DIR until this is resolved" >&2
	exit 1
fi
